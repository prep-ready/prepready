# PrepReady — Hostinger (LiteSpeed/Apache)
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# Wymuś HTTPS i domenę bez www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://prepready.pro/$1 [R=301,L]

# Strona główna -> wersja polska
RewriteRule ^$ /pl/ [R=301,L]

# Stare wpisy z WordPressa (EN) -> nowe poradniki
RewriteRule ^emergency-bug-out-kit-essentials/?$ /en/guides/go-bag-checklist/ [R=301,L]
RewriteRule ^(car-emergency-kit-essentials|winter-car-emergency-kit|budget-get-home-bag-ice-storm|personalized-medical-supply-kit-seniors)/?$ /en/guides/go-bag-checklist/ [R=301,L]
RewriteRule ^(mastering-emergency-codes-flood-communication|master-emergency-communication-codes-family-safety)/?$ /en/guides/ [R=301,L]
# Pozostałe stare adresy i strony WP (sklep, konto, afiliacja, blog, kategorie)
RewriteRule ^(shop|cart|checkout|my-account|affiliate-[a-z-]+|affiliate-program)/?$ /pl/ [R=301,L]
RewriteRule ^blog/?$ /pl/poradniki/ [R=301,L]
RewriteRule ^free-resources/?$ /pl/checklisty/plecak-72h/ [R=301,L]
RewriteRule ^about-us/?$ /pl/o-nas/ [R=301,L]
RewriteRule ^contact/?$ /pl/o-nas/ [R=301,L]
RewriteRule ^category/.*$ /pl/poradniki/ [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php).*$ - [G,L]
# Każdy inny stary slug wpisu -> lista poradników EN
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!pl/|en/)([a-z0-9-]+)/?$ /en/guides/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2|svg|png|jpg|webp|avif)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
