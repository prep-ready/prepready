---
/** Strona tematu (hub): wszystkie poradniki z jednego `cluster` + narzędzia. Teksty w src/data/hubs.ts. */
import Base from '../layouts/Base.astro';
import { clusters, routes, guideBase, t, fmtDate, type Lang } from '../i18n/ui';
import { articles, hrefOf } from '../lib/articles';
import { hubs, hubHref, hubExists } from '../data/hubs';
import { cities } from '../data/cities';

type Cluster = keyof typeof hubs;
interface Props { lang: Lang; cluster: Cluster }
const { lang, cluster } = Astro.props;
const h = hubs[cluster][lang];
const all = await articles(lang);
const list = all
  .filter((a) => a.data.cluster === cluster)
  .sort((a, b) => (a.data.kind === 'pillar' ? -1 : 0) - (b.data.kind === 'pillar' ? -1 : 0) || b.data.readingMinutes - a.data.readingMinutes);
const here = hubHref(cluster, lang);
// Inne tematy z hubem w tym języku
const others = (Object.keys(hubs) as Cluster[])
  .filter((c) => c !== cluster && hubExists(c, lang, all.filter((a) => a.data.cluster === c).length));
// Wersja w drugim języku, jeśli tam też istnieje hub
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const otherCount = (await articles(other)).filter((a) => a.data.cluster === cluster).length;
const alternates = { [lang]: here, ...(hubExists(cluster, other, otherCount) ? { [other]: hubHref(cluster, other) } : {}) } as Partial<Record<Lang, string>>;
const tools = lang === 'pl'
  ? [
      { href: routes.checklist.pl, label: 'Checklista plecaka ewakuacyjnego 72h', show: ['bag', 'evacuation', 'water-food', 'first-aid'] },
      { href: routes.shelters.pl, label: 'Mapa schronów: najbliższy schron od Twojego adresu', show: ['shelter', 'evacuation'] },
      { href: `${guideBase.pl}syreny-alarmowe/`, label: 'Sygnały alarmowe: posłuchaj syren', show: ['shelter'] },
      { href: routes.index.pl, label: 'Indeks gotowości: jak bardzo trzeba się dziś przygotować', show: ['evacuation', 'blackout'] },
    ].filter((x) => x.show.includes(cluster) && x.href !== here)
  : [
      { href: routes.checklist.en, label: '72-hour go-bag checklist', show: ['bag', 'evacuation', 'water-food', 'first-aid'] },
      { href: routes.index.en, label: 'Readiness index: how prepared should you be today', show: ['evacuation', 'blackout'] },
    ].filter((x) => x.show.includes(cluster));
const url = new URL(here, Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: h.title, description: h.desc, url, inLanguage: lang,
    mainEntity: { '@type': 'ItemList', itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(hrefOf(a), Astro.site).href, name: a.data.title })) } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'PrepReady', item: new URL(routes.home[lang], Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t(lang, 'nav.guides'), item: new URL(routes.guides[lang], Astro.site).href },
    { '@type': 'ListItem', position: 3, name: clusters[cluster][lang], item: url },
  ] },
];
---
<Base lang={lang} title={h.title} description={h.desc} alternates={alternates} current="guides" jsonLd={jsonLd}>
  <div class="wrap page-head">
    <div class="eyebrow"><a href={routes.guides[lang]}>{t(lang, 'nav.guides')}</a> · {clusters[cluster][lang]}</div>
    <h1>{h.h1}</h1>
    {h.intro.map((p) => <p>{p}</p>)}
  </div>
  <div class="wrap">
    {h.start && <p class="start"><strong>{lang === 'pl' ? 'Od czego zacząć:' : 'Where to start:'}</strong> {h.start}</p>}
    <ol class="list">
      {list.map((a) => (
        <li>
          <a href={hrefOf(a)}>{a.data.title}</a>
          <p>{a.data.description}</p>
          <span>{a.data.readingMinutes} {t(lang, 'g.min')} · {t(lang, 'g.reviewed')} {fmtDate(a.data.reviewed, lang)}</span>
        </li>
      ))}
    </ol>

    {cluster === 'shelter' && lang === 'pl' && (
      <section class="sec">
        <h2>Schrony w największych miastach</h2>
        <ul class="cols">
          {cities.map((c) => <li><a href={`${routes.shelters.pl}${c.slug}/`}>Schrony {c.loc}</a></li>)}
        </ul>
      </section>
    )}

    {tools.length > 0 && (
      <section class="sec">
        <h2>{lang === 'pl' ? 'Narzędzia' : 'Tools'}</h2>
        <ul class="cols">{tools.map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul>
      </section>
    )}

    {others.length > 0 && (
      <section class="sec">
        <h2>{lang === 'pl' ? 'Inne tematy' : 'Other topics'}</h2>
        <ul class="cols">{others.map((c) => <li><a href={hubHref(c, lang)}>{clusters[c][lang]}</a></li>)}</ul>
      </section>
    )}
  </div>
</Base>
<style>
  .page-head .eyebrow a{color:inherit}
  .page-head p{max-width:70ch}
  .start{font-family:var(--body);font-size:16px;line-height:1.6;color:var(--ink-2);max-width:70ch;margin:0 0 20px;padding:14px 0;border-block:1px solid var(--line)}
  .list{list-style:none;margin:0;padding:0;display:grid;gap:0}
  .list li{padding:16px 0;border-bottom:1px solid var(--line);display:grid;gap:4px}
  .list a{font-weight:700;font-size:18px;text-decoration:none;color:var(--ink)}
  .list a:hover{color:var(--action)}
  .list p{font-family:var(--body);font-weight:var(--body-w);font-size:15px;color:var(--ink-2);margin:0;max-width:70ch}
  .list span{font-family:var(--mono);font-size:12px;color:var(--muted)}
  .sec{margin-top:36px}
  .sec h2{font-size:20px;margin-bottom:12px}
  .cols{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px 18px}
  .cols a{color:var(--action);text-decoration:none;font-weight:600}
  .cols a:hover{text-decoration:underline}
</style>
