---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import Community from '../components/Community.astro';
import { clusters, routes, t, fmtDate, type Lang } from '../i18n/ui';
import { hrefOf, translationOf, type Article } from '../lib/articles';

interface Props { entry: Article }
const { entry } = Astro.props;
const d = entry.data;
const lang = d.lang as Lang;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const tr = await translationOf(entry);
const here = hrefOf(entry);
const alternates = { [lang]: here, ...(tr ? { [tr.data.lang]: hrefOf(tr) } : {}) } as Partial<Record<Lang, string>>;
const url = new URL(here, Astro.site).href;
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, inLanguage: lang,
    datePublished: d.pubDate.toISOString(), dateModified: d.reviewed.toISOString(), mainEntityOfPage: url,
    author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: 'PrepReady', url: Astro.site?.href },
    citation: d.sources.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'PrepReady', item: new URL(routes.home[lang], Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t(lang, 'nav.guides'), item: new URL(routes.guides[lang], Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) jsonLd.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<Base lang={lang} title={d.title} description={d.description} alternates={alternates} current="guides" ogType="article" jsonLd={jsonLd} noindex={d.draft}>
  <article class="wrap art">
    <header class="ahead">
      <nav class="crumbs" aria-label="breadcrumb">
        <a href={routes.guides[lang]}>{t(lang, 'nav.guides')}</a> <span aria-hidden="true">/</span> <span>{clusters[d.cluster][lang]}</span>
      </nav>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <dl class="byline">
        <div><dt>{t(lang, 'art.by')}</dt><dd>{d.author}</dd></div>
        {d.reviewer && <div><dt>{t(lang, 'art.reviewedBy')}</dt><dd>{d.reviewer}</dd></div>}
        <div><dt>{t(lang, 'art.reviewed')}</dt><dd><time datetime={d.reviewed.toISOString()}>{fmtDate(d.reviewed, lang)}</time></dd></div>
        <div><dt>⏱</dt><dd>{d.readingMinutes} {t(lang, 'g.min')}</dd></div>
      </dl>
    </header>

    <div class="layout">
      {toc.length > 1 && (
        <aside class="toc">
          <div class="eyebrow">{t(lang, 'art.toc')}</div>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </aside>
      )}
      <div class="prose">
        <Content />

        {d.faq.length > 0 && (
          <section class="faq">
            <h2 id="faq">{t(lang, 'art.faq')}</h2>
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}

        {d.sources.length > 0 && (
          <section class="sources">
            <h2 id="zrodla">{t(lang, 'art.sources')}</h2>
            <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ol>
          </section>
        )}

        <div style="margin-top:28px"><Community lang={lang} /></div>

        <p class="disclaimer">{t(lang, 'art.disclaimer')}</p>
      </div>
    </div>
  </article>
</Base>

<style>
  .art{padding-block:36px 20px}
  .ahead{max-width:820px}
  .crumbs{font-family:var(--mono);font-size:12px;color:var(--muted)}
  .crumbs a{color:var(--action);text-decoration:none}
  h1{font-size:clamp(30px,4vw,44px);font-weight:780;font-stretch:78%;letter-spacing:-.01em;margin-top:12px}
  .dek{font-family:var(--body);font-size:17px;color:var(--ink-2);margin-top:14px;max-width:62ch}
  .byline{display:flex;flex-wrap:wrap;gap:8px 24px;margin:22px 0 0;padding-block:14px;border-block:1px solid var(--line);font-size:13px}
  .byline div{display:flex;gap:6px}
  dt{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding-top:2px}
  dd{margin:0;font-weight:600}
  .layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:48px;margin-top:32px}
  .toc{position:sticky;top:90px;align-self:start}
  .toc ol{list-style:none;padding:0;margin:10px 0 0;display:grid;gap:8px;font-size:14px;border-left:2px solid var(--line)}
  .toc a{text-decoration:none;color:var(--ink-2);display:block;padding-left:12px}
  .toc a:hover{color:var(--action)}
  .faq details{border-bottom:1px solid var(--line);padding:12px 0}
  .faq summary{font-family:var(--display);font-weight:600;cursor:pointer;font-size:16px;color:var(--ink)}
  .faq details p{margin:8px 0 0}
  .sources ol{font-size:15px}
  .disclaimer{margin-top:32px;padding:14px 16px;background:var(--surface-2);border-radius:8px;font-size:14px;color:var(--ink-2)}
  @media (max-width:900px){ .layout{grid-template-columns:1fr;gap:16px} .toc{position:static} .prose{font-size:17px} }
</style>
