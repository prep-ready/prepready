+---
+import V from '../../../../views/HubView.astro';
+import { hubs, hubExists } from '../../../../data/hubs';
+import { articles } from '../../../../lib/articles';
+export async function getStaticPaths() {
+  const list = await articles('en');
+  return (Object.keys(hubs) as (keyof typeof hubs)[])
+    .filter((c) => hubExists(c, 'en', list.filter((a) => a.data.cluster === c).length))
+    .map((cluster) => ({ params: { topic: hubs[cluster].en.slug }, props: { cluster } }));
+}
+const { cluster } = Astro.props;
+---
+<V lang="en" cluster={cluster} />
