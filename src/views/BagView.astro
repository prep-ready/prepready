    .hint-2{display:none}
    .hs-card.dock{left:8px;right:8px;top:auto;bottom:8px;width:auto;transform:none}
    .hs-card.dock .hc-list :global(.hw){-webkit-line-clamp:1}
    .hs-card.dock .hc-list :global(li){padding:6px 14px}
    .row2{grid-template-columns:1fr}
    .hs span{font-size:10px;padding:4px 6px}
    .cta-row .btn{flex:1 1 auto;justify-content:center}
  }
</style>
