---
/**
 * Strona „Plecak ewakuacyjny PrepReady” (/pl/plecak-ewakuacyjny/): model 3D z saszetkami, wybór wersji i koloru,
 * edytowalna lista rzeczy z przykładowymi produktami i cenami, opis plecaka i zgłoszenie.
 * Zawartość, produkty i warianty plecaka edytujesz w src/data/plecak.ts. Model 3D: src/lib/bag3d.ts.
 * Formularz wysyła przez /contact.php, tak samo jak formularze „Dla producentów” i „Reklama”.
 *
 * Linki (np. do maili do producentów):
 *   /pl/plecak-ewakuacyjny/?wersja=rozszerzony#rzecz-elektrolity   przewija do rzeczy, wyróżnia ją i otwiera jej saszetkę na modelu
 *   /pl/plecak-ewakuacyjny/#saszetka-woda                           cała saszetka
 *   ?wersja=podstawowy|rozszerzony|pro, &kolor=<id koloru>, własny zestaw: ?wersja=wlasny&baza=podstawowy&dodaj=filtr,pmr&usun=gwizdek
 */
import Base from '../layouts/Base.astro';
import {
  bagCategories, bagItems, bagVersions, itemsFor, levelOrder, levelLoc, rzeczy, saszetek, zl, cenyZDnia, pouchName, bagModel,
} from '../data/plecak';
import { routes, guideBase } from '../i18n/ui';

const path = '/pl/plecak-ewakuacyjny/';
const pageUrl = new URL(path, Astro.site).href;
const title = 'Plecak ewakuacyjny PrepReady: 4 wersje, co jest w środku';
const description = 'Plecak ewakuacyjny w 3D: kolorowe saszetki na wodę, jedzenie, apteczkę i resztę, przykładowe produkty z cenami i zestaw, który ułożysz sam. Podstawowy, Rozszerzony, Pro albo własny.';

const basic = itemsFor('basic');
const counts = Object.fromEntries(bagVersions.map((v) => [v.id, v.id === 'custom' ? basic.length : itemsFor(v.id).length]));
const catCount = (cat: string) => basic.filter((i) => i.cat === cat).length;
const pouches = bagCategories.filter((c) => c.pouch);
const MODEL_URL = '/models/plecak-ewakuacyjny.glb';
const REKLAMA = '/pl/reklama/';
const cenyDate = cenyZDnia();
const defColor = bagModel.colors.find((c) => c.id === bagModel.defaultColor)!;
// Pasek „Co już mamy w plecaku testowym”: rzeczy z wpisanym partnerem
const kit = bagItems.filter((i) => i.partner).map((i) => ({ brand: i.partner!, what: i.model ? `${i.name} ${i.model}` : i.name, cat: i.cat }));
const catById = new Map(bagCategories.map((c) => [c.id, c]));
const swatchBg = (c: (typeof bagModel.colors)[number]) => c.palette
  ? `background:linear-gradient(135deg,${c.palette.map((h, i, a) => `${h} ${(i / a.length) * 100}% ${((i + 1) / a.length) * 100}%`).join(',')})`
  : `background:${c.hex}`;
const basicPrice = basic.reduce((s, i) => s + (i.produkt?.cena ?? 0), 0);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'PrepReady', item: new URL(routes.home.pl, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Plecak ewakuacyjny', item: pageUrl },
    ],
  },
  ...bagVersions.filter((v) => v.id !== 'custom').map((v) => ({
    '@context': 'https://schema.org', '@type': 'ItemList', inLanguage: 'pl',
    name: `Plecak ewakuacyjny ${v.name}: zawartość`, description: v.desc, url: `${pageUrl}?wersja=${v.slug}`,
    numberOfItems: itemsFor(v.id).length, itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: itemsFor(v.id).map((i, n) => ({ '@type': 'ListItem', position: n + 1, name: i.name, description: i.why, url: `${pageUrl}?wersja=${v.slug}#rzecz-${i.id}` })),
  })),
];
---
<Base lang="pl" title={title} description={description} alternates={{ pl: path }} jsonLd={jsonLd}>
  <div class="bag-page" data-bag data-model={MODEL_URL}>
    <section class="wrap hero">
      <div class="h-head">
        <p class="eyebrow">Plecak ewakuacyjny PrepReady · kompletujemy</p>
        <h1>Plecak ewakuacyjny: wybierz wersję i zobacz, co jest w środku</h1>
        <p class="lead">Wszystko pakujemy w kolorowe saszetki: niebieska to woda, zielona z białym krzyżem to apteczka, żółta to światło i prąd. Otwórz plecak, wybierz wersję i sprawdź każdą rzecz z przykładowym produktem i ceną. Pierwsze zestawy kompletujemy teraz.</p>
      </div>

      <div class="stage panel" id="bag-stage">
        <canvas class="gl" aria-hidden="true"></canvas>
        <div class="hs-layer" aria-hidden="true">
          {bagCategories.map((c) => (
            <button class="hs" type="button" tabindex="-1" data-cat={c.id} style={c.pouch ? `--c:${c.pouch.hex}` : undefined}><i></i><span>{c.short} <b>{catCount(c.id)}</b></span></button>
          ))}
        </div>
        <div class="hs-card" role="dialog" aria-labelledby="hc-t" hidden>
          <div class="hc-head">
            <div class="hc-tt">
              <p class="hc-t" id="hc-t"></p>
              <p class="hc-p"><i class="dot"></i><span></span></p>
            </div>
            <span class="hc-n"></span>
            <button class="hc-x" type="button" aria-label="Zamknij">&times;</button>
          </div>
          <p class="hc-note" hidden></p>
          <ul class="hc-list"></ul>
          <a class="hc-more" href="#zawartosc">Zobacz na liście</a>
        </div>
        <div class="fallback">
          <p class="eyebrow">Saszetki w plecaku</p>
          <ul>
            {bagCategories.map((c) => <li data-cat={c.id}><span>{c.pouch && <i class="dot" style={`--c:${c.pouch.hex}`}></i>}{c.pouch ? `${c.pouch.colorName}: ${c.name}` : c.name}</span><b>{catCount(c.id)}</b></li>)}
          </ul>
        </div>
        <button class="open-btn" type="button" aria-pressed="false" data-open hidden><span class="ob-i" aria-hidden="true"></span><span data-open-l>Otwórz plecak</span></button>
        <p class="hint">Przeciągnij, aby obrócić<span class="hint-2">. Kliknij punkt albo saszetkę</span></p>
      </div>

      <div class="h-pick">
        <p class="eyebrow" id="ver-label">Wersja plecaka</p>
        <div class="vers" role="group" aria-labelledby="ver-label">
          {bagVersions.map((v, i) => (
            <button class="ver" type="button" data-ver={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="vn">{v.name}</span>
              <span class="vc" data-count={v.id}>{v.id === 'custom' ? 'do wyboru' : `${counts[v.id]} ${rzeczy(counts[v.id])}`}</span>
              <span class="vd">{v.desc}</span>
            </button>
          ))}
        </div>
        <p class="ver-desc" aria-live="polite">{bagVersions[0].desc}</p>

        <div class="colors">
          <p class="eyebrow" id="col-label">Kolor plecaka: <span class="col-name" data-col-name>{defColor.name}</span></p>
          <div class="sw-row" role="radiogroup" aria-labelledby="col-label">
            {bagModel.colors.map((c) => (
              <button class="sw" type="button" role="radio" aria-checked={c.id === defColor.id ? 'true' : 'false'} data-color={c.id}
                aria-label={c.name} title={c.desc ? `${c.name}: ${c.desc}` : c.name} style={swatchBg(c)}></button>
            ))}
          </div>
          <p class="col-note" data-col-note>{defColor.cena ? `${zl(defColor.cena)} u producenta · ` : ''}ten kolor mamy w plecaku testowym</p>
        </div>

        <div class="cta-row">
          <a class="btn primary" href="#zgloszenie">Zapytaj o plecak</a>
          <a class="btn ghost" href="#zawartosc">Lista rzeczy</a>
        </div>
      </div>
    </section>

    <section class="wrap kit" aria-labelledby="kit-h">
      <p class="eyebrow" id="kit-h">Co już mamy w plecaku testowym</p>
      <ul class="kit-list">
        {kit.map((k) => (
          <li><button class="kit-chip" type="button" data-show={k.cat}><b>{k.brand}</b><span>{k.what}</span></button></li>
        ))}
      </ul>
      <p class="kit-note">Pozostały sprzęt właśnie dobieramy i testujemy.</p>
    </section>

    <section class="block" id="zawartosc" aria-labelledby="list-h">
      <div class="wrap">
        <div class="sec-head l-head">
          <div>
            <p class="eyebrow">Zawartość</p>
            <h2 id="list-h">W plecaku: <span data-vname>Podstawowy</span> <span class="hcount" data-total>{basic.length} {rzeczy(basic.length)}</span></h2>
            <p class="lead">Zaznacz, co ma być w plecaku. Wybierz gotową wersję albo dopasuj ją: odznacz zbędne rzeczy, a dodatkowe znajdziesz pod każdą saszetką.</p>
          </div>
          <div class="seg" role="group" aria-label="Wersja plecaka">
            {bagVersions.map((v, i) => (
              <button class="seg-b" type="button" data-ver={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{v.id === 'custom' ? 'Własny' : v.name}</button>
            ))}
          </div>
        </div>

        <div class="custom-bar" hidden>
          <span class="cb-label" data-cb-label>Własny zestaw na bazie wersji Podstawowej</span>
          <button class="chip" type="button" data-reset>Przywróć wersję</button>
          <button class="chip" type="button" data-clear>Wyczyść wszystko</button>
        </div>

        <div class="cfg">
          <div class="cats" data-mode="basic">
            {bagCategories.map((c) => {
              const items = bagItems.filter((i) => i.cat === c.id);
              return (
                <section class="cat" id={c.pouch ? `saszetka-${c.id}` : `kat-${c.id}`} data-cat={c.id} aria-labelledby={`kat-${c.id}-h`} style={c.pouch ? `--c:${c.pouch.hex}` : undefined}>
                  <header>
                    <i class="cat-dot" aria-hidden="true"></i>
                    <div class="ch-t">
                      <h3 id={`kat-${c.id}-h`}>{c.name} <span class="cc" data-cc>{catCount(c.id)}</span></h3>
                      <p class="ch-p">{c.pouch ? pouchName(c) : 'Bez saszetki'}</p>
                    </div>
                    <button class="cat-show" type="button" data-show={c.id} aria-label={`Pokaż ${c.pouch ? pouchName(c).toLowerCase() : 'plecak'} w modelu 3D`}>{c.pouch ? 'Pokaż w 3D' : 'Pokaż plecak'}</button>
                  </header>
                  {c.note && <p class="cat-note">{c.note}</p>}
                  <ul class="in-list" data-in></ul>
                  <p class="empty" data-empty hidden>Ta saszetka jest pusta. Dodaj coś poniżej albo zostaw ją w domu.</p>
                  <details class="can-add" data-add>
                    <summary><span data-add-l>Możesz dodać</span></summary>
                    <ul class="out-list" data-out>
                      {items.map((i) => {
                        const p = i.produkt;
                        const showBrand = p && !p.nazwa.toLowerCase().includes(p.marka.split(/[ /(]/)[0].toLowerCase());
                        return (
                          <li id={`rzecz-${i.id}`} data-id={i.id} data-level={i.level} data-cat={i.cat}>
                            <label class="it">
                              <input type="checkbox" value={i.id} aria-label={`W plecaku: ${i.name}`} />
                              <span class="ck" aria-hidden="true"></span>
                              <span class="it-b">
                                <span class="it-h">
                                  <span class="in">{i.name}</span>
                                  <span class={`ip${p?.cena == null ? ' na' : ''}`} data-pp>{p?.cena != null ? zl(p.cena) : 'cena wkrótce'}</span>
                                </span>
                                <span class="iw">{i.why}</span>
                                <span class="lvl" data-lvl></span>
                                {i.outside && <span class="where"><i class="dot out"></i>Na zewnątrz: {i.outside}</span>}
                              </span>
                            </label>
                            <p class="prod" data-prod>
                              {p ? (
                                <Fragment>
                                  <span class="pn">{showBrand && <Fragment><b data-pm>{p.marka}</b> </Fragment>}<span data-pn>{p.nazwa}</span></span>
                                  {p.uwaga && <span class="ph">{p.uwaga}</span>}
                                  {p.url && <a class="pu" data-pu href={p.url} rel="sponsored noopener" target="_blank">Zobacz<span class="sr-only"> produkt: {p.nazwa} (nowa karta)</span></a>}
                                  {p.dodatkowe?.map((u, k) => <a class="pu" href={u} rel="sponsored noopener" target="_blank">{p.dodatkowe!.length > 1 ? `część ${k + 2}` : 'druga część'}<span class="sr-only"> (nowa karta)</span></a>)}
                                </Fragment>
                              ) : (
                                <span class="pn na">Przykładowy produkt wkrótce</span>
                              )}
                              {!p?.partner && <a class="slot" href={REKLAMA}>Miejsce dla producenta</a>}
                            </p>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                </section>
              );
            })}
          </div>

          <aside class="side" aria-label="Podsumowanie zestawu">
            <div class="side-in">
              <div class="total panel" aria-live="polite">
                <p class="eyebrow">Twój zestaw</p>
                <p class="t-v" data-t-v>Podstawowy</p>
                <div class="t-stats">
                  <p><b data-t-items>{basic.length}</b> <span data-t-items-l>{rzeczy(basic.length)}</span></p>
                  <p><b data-t-pouches>{pouches.length}</b> <span data-t-pouches-l>{saszetek(pouches.length)}</span></p>
                </div>
                <p class="t-l">Szacunkowo <b data-t-sum>{zl(basicPrice)}</b><span class="t-miss" data-t-miss></span></p>
                <a class="btn primary t-btn" href="#zgloszenie">Zapytaj o ten zestaw</a>
                <p class="t-note">{cenyDate ? `Ceny przykładowych produktów z dnia ${cenyDate}, mogą się zmienić. Dokładną wycenę wyślemy mailem.` : 'Ceny przykładowych produktów właśnie uzupełniamy i mogą się zmienić. Dokładną wycenę wyślemy mailem.'}</p>
              </div>

              <div class="psum panel" aria-live="polite">
                <p class="ps-h"><b data-ps-n>{pouches.length} {saszetek(pouches.length)}</b><span data-ps-sub></span></p>
                <ul class="ps-list">
                  {pouches.map((c) => (
                    <li data-cat={c.id} title="">
                      <a href={`#saszetka-${c.id}`}>
                        <i class="dot" style={`--c:${c.pouch!.hex}`}></i>
                        <span class="ps-c">{c.name}</span>
                        <span class="ps-k" data-ps-k></span>
                      </a>
                      <span class="ps-i" data-ps-i hidden></span>
                    </li>
                  ))}
                </ul>
                <p class="ps-out" data-ps-out></p>
              </div>
            </div>
          </aside>
        </div>

        <p class="more">Pakujesz się sam? Odhaczaj rzeczy w <a href={routes.checklist.pl}>checkliście plecaka 72h</a> i przeczytaj, <a href={`${guideBase.pl}plecak-ewakuacyjny/`}>co spakować do plecaka ewakuacyjnego</a>. Gotowe zestawy dostępne w sklepach porównujemy w zestawieniu <a href={`${guideBase.pl}gotowy-plecak-ewakuacyjny/`}>gotowych plecaków ewakuacyjnych</a>.</p>
      </div>
    </section>

    <section class="block about" id="o-plecaku" aria-labelledby="about-h">
      <div class="wrap a-grid">
        <div>
          <p class="eyebrow">O plecaku</p>
          <h2 id="about-h">O plecaku: {bagModel.name}</h2>
          <div class="a-text">
            {bagModel.opis.map((p) => <p>{p}</p>)}
          </div>
          <p class="a-link"><a class="link-more" href={bagModel.url} rel="sponsored noopener" target="_blank">Strona plecaka u producenta<span class="sr-only"> (nowa karta)</span></a></p>
        </div>
        <div>
          <dl class="specs">
            {bagModel.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <p class="eyebrow a-col-h">Kolory ({bagModel.colors.length})</p>
          <ul class="a-cols">
            {bagModel.colors.map((c) => (
              <li><button type="button" data-color={c.id} aria-pressed={c.id === defColor.id ? 'true' : 'false'}><i class="sw-s" style={swatchBg(c)}></i><span>{c.name}</span>{c.cena && <span class="a-p">{zl(c.cena)}</span>}</button></li>
            ))}
          </ul>
          <p class="a-src">Opis i ceny według strony producenta ({bagModel.sprawdzono.split('-').reverse().join('.')}). Kolory na modelu są przybliżone, kamuflaże rysujemy w uproszczeniu.</p>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="note-h">
      <div class="wrap">
        <div class="sec-head"><div><h2 id="note-h">Tego nie spakujemy za Ciebie</h2></div></div>
        <div class="notes">
          <div class="note">
            <span class="num">01</span>
            <h3>Jodek potasu</h3>
            <p>Jodku potasu nie ma w naszych plecakach. W Polsce tabletki rozdaje państwo w punktach wyznaczonych przez gminy, a przyjmuje się je wyłącznie na polecenie władz, ogłoszone w komunikatach RCB, radiu i telewizji. Szczegóły w poradniku <a href={`${guideBase.pl}jodek-potasu-tabletki/`}>jodek potasu: kiedy brać</a>.</p>
          </div>
          <div class="note">
            <span class="num">02</span>
            <h3>Twoje leki</h3>
            <p>Dołóż leki na receptę, które przyjmujesz na stałe, na co najmniej 7 dni, razem z rozpiską dawek. Jeśli nosisz okulary lub soczewki, spakuj zapasową parę.</p>
          </div>
          <div class="note">
            <span class="num">03</span>
            <h3>Kopie dokumentów</h3>
            <p>Do wodoodpornego etui włóż kopie dowodu, paszportu, aktów i polis oraz gotówkę w drobnych nominałach. Zdjęcia dokumentów zapisz też w telefonie.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="form-h">
      <div class="wrap fgrid">
        <div class="prose">
          <h2 id="form-h">Zapytaj o plecak</h2>
          <p>Kompletujemy teraz pierwsze plecaki. Wybierz wersję albo ułóż własną listę, zostaw imię i e-mail, a odpiszemy z wyceną i informacją o dostępności.</p>
          <p class="lead-time">Ze względu na dużą liczbę zgłoszeń skompletowanie plecaka może potrwać do 10 dni. Potrzebujesz kilku sztuk albo zamówienia hurtowego? Napisz o tym w uwagach: cenę ustalimy indywidualnie, a termin dopasujemy do wielkości zamówienia.</p>
          <p>Zgłoszenie do niczego nie zobowiązuje. Twoje dane służą tylko do odpowiedzi na nie.</p>
        </div>
        <form class="pform panel" id="zgloszenie" method="post" action="/contact.php" novalidate
          data-ok="Dziękujemy! Zgłoszenie dotarło. Odpiszemy na podany e-mail z wyceną i informacją o dostępności plecaka."
          data-err="Nie udało się wysłać. Sprawdź pola i spróbuj ponownie za chwilę."
          data-sending="Wysyłanie…">
          <input type="hidden" name="lang" value="pl" />
          <input type="hidden" name="t" value="" />
          <input type="hidden" name="company" value="" />
          <input type="hidden" name="category" value="" />
          <input type="hidden" name="message" value="" />
          <div class="hp" aria-hidden="true"><label for="bg-website">Website</label><input id="bg-website" name="website_url" tabindex="-1" autocomplete="off" /></div>
          <label class="f"><span>Wersja plecaka</span>
            <select id="bg-version" name="version">
              {bagVersions.map((v) => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>
          <div class="sel-box" aria-live="polite">
            <p class="sel-sum"></p>
            <ul class="sel-items"></ul>
            <p class="sel-total"></p>
            <p class="sel-edit">Listę zmienisz wyżej, w sekcji <a href="#zawartosc">W plecaku</a>.</p>
          </div>
          <div class="row2">
            <label class="f"><span>Imię</span><input name="name" required autocomplete="given-name" /></label>
            <label class="f"><span>E-mail</span><input name="email" type="email" required autocomplete="email" inputmode="email" /></label>
          </div>
          <label class="f"><span>Uwagi (opcjonalnie)</span><textarea id="bg-note" rows="4" placeholder="Np. ile plecaków, dla kogo (dziecko, senior), czego potrzebujesz więcej."></textarea></label>
          <label class="check"><input type="checkbox" name="consent" value="1" required /><span>Zgadzam się na kontakt w sprawie plecaka. Dane służą tylko do odpowiedzi na to zgłoszenie.</span></label>
          <div class="actions">
            <button class="btn primary" type="submit">Wyślij zgłoszenie</button>
            <p class="status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>

    <div class="sbar" data-sbar>
      <p class="sb-t"><span class="sb-v" data-sb-v>Podstawowy</span><span class="sb-c" data-sb-c>{basic.length} {rzeczy(basic.length)}</span></p>
      <a class="btn primary" href="#zgloszenie">Zapytaj o plecak</a>
    </div>
  </div>
</Base>

<script>
  import {
    bagCategories, bagItems, bagVersions, levelOrder, levelLoc, rzeczy, saszetek, zl, pouchName, bagModel,
    type BagLevel, type BagVersionId,
  } from '../data/plecak';

  const root = document.querySelector<HTMLElement>('[data-bag]');
  if (root) {
    const KEY = 'pr-plecak-zestaw';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const byId = new Map(bagItems.map((i) => [i.id, i]));
    const catById = new Map(bagCategories.map((c) => [c.id, c]));
    const verById = new Map(bagVersions.map((v) => [v.id, v]));
    const slugToVer = new Map<string, BagVersionId>(bagVersions.flatMap((v) => [[v.slug, v.id], [v.id, v.id]] as [string, BagVersionId][]));
    const colorById = new Map(bagModel.colors.map((c) => [c.id, c]));
    const lvl = (l: BagLevel) => levelOrder.indexOf(l);

    /* ── Stan: wersja bazowa + rzeczy dodane i usunięte przez czytelnika ── */
    let base: BagLevel = 'basic';
    let add = new Set<string>(), rem = new Set<string>();
    let customFlag = false;
    let color = bagModel.defaultColor;
    const ids = (s: string | null) => (s ? s.split(',').filter((x) => byId.has(x)) : []);
    {
      const q = new URLSearchParams(location.search);
      const w = q.get('wersja');
      const hasQ = !!(w || q.get('dodaj') || q.get('usun'));
      if (hasQ) {
        const v = slugToVer.get(w || '') || 'basic';
        if (v === 'custom') { customFlag = true; const b = slugToVer.get(q.get('baza') || '') || 'basic'; base = b === 'custom' ? 'basic' : b; }
        else base = v;
        add = new Set(ids(q.get('dodaj'))); rem = new Set(ids(q.get('usun')));
      } else {
        try {
          const s = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (s && levelOrder.includes(s.base)) { base = s.base; add = new Set(ids((s.add || []).join(','))); rem = new Set(ids((s.rem || []).join(','))); customFlag = !!s.custom; }
        } catch {}
      }
      const k = q.get('kolor');
      if (k && colorById.has(k)) color = k;
    }
    const inBase = (id: string) => lvl(byId.get(id)!.level) <= lvl(base);
    const inKit = (id: string) => (inBase(id) && !rem.has(id)) || add.has(id);
    const isCustom = () => customFlag || add.size > 0 || rem.size > 0;
    const kitItems = () => bagItems.filter((i) => inKit(i.id));
    const verLabel = () => (isCustom() ? `Własny (na bazie ${verById.get(base)!.gen})` : verById.get(base)!.name);
    const priceOf = (id: string): number | null => {
      if (id === 'plecak') return colorById.get(color)?.cena ?? byId.get(id)!.produkt?.cena ?? null;
      return byId.get(id)!.produkt?.cena ?? null;
    };

    const $ = <T extends HTMLElement = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
    const stage = $('#bag-stage');
    const verBtns = $$<HTMLButtonElement>('[data-ver]');
    const verDesc = $('.ver-desc');
    const cats = $('.cats');
    const rows = $$<HTMLLIElement>('.cats li[data-id]');
    const groups = $$('.cat');
    const bar = $('.custom-bar');
    const vname = $('[data-vname]');
    const total = $('[data-total]');
    const customCount = $('[data-count="custom"]');
    const hotspots = $$('.hs', stage);
    const fallbackRows = $$('.fallback li', stage);
    const card = $('.hs-card', stage);
    const openBtn = $<HTMLButtonElement>('[data-open]', stage);
    const form = $<HTMLFormElement>('#zgloszenie');
    const sel = $<HTMLSelectElement>('#bg-version', form);
    const selBox = $('.sel-box', form);
    const sbar = $('[data-sbar]');
    let bag: import('../lib/bag3d').BagHandle | null = null;
    let picked: string | null = null;

    /** Licznik „przewijający się” do nowej wartości */
    const tween = (el: HTMLElement, to: number, fmt: (n: number) => string, animate: boolean) => {
      const from = el.dataset.n === undefined ? to : Number(el.dataset.n);
      el.dataset.n = String(to);
      const token = String(Math.random());
      el.dataset.tk = token;
      if (!animate || reduce || from === to) { el.textContent = fmt(to); return; }
      el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump');
      const t0 = performance.now(), dur = 420;
      const step = (now: number) => {
        if (el.dataset.tk !== token) return;
        const k = Math.min(1, (now - t0) / dur);
        el.textContent = fmt(Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const nR = (n: number) => `${n} ${rzeczy(n)}`;
    const nS = (n: number) => `${n} ${saszetek(n)}`;
    const zlR = (n: number) => zl(Math.round(n));

    /* ── Karta przy punkcie na modelu ── */
    const fillCard = () => {
      if (!picked) return;
      const c = catById.get(picked)!;
      const items = kitItems().filter((i) => i.cat === picked);
      $('.hc-t', card).textContent = c.name;
      const hp = $('.hc-p', card);
      hp.hidden = !c.pouch;
      if (c.pouch) { hp.style.setProperty('--c', c.pouch.hex); $('span', hp).textContent = pouchName(c); }
      $('.hc-n', card).textContent = nR(items.length);
      const note = $('.hc-note', card);
      note.hidden = !c.note; note.textContent = c.note || '';
      const ul = $('.hc-list', card);
      // Bez przewijania w karcie: na telefonie najwyżej 3 rzeczy, reszta na liście
      const isOpen = stage.classList.contains('is-open');
      const max = stage.clientWidth < 560 ? (isOpen ? 2 : 3) : isOpen ? 4 : 6;
      const more = Math.max(0, items.length - max);
      ul.replaceChildren(...items.slice(0, max).map((i) => {
        const li = document.createElement('li');
        const top = document.createElement('span'); top.className = 'hn';
        const n = document.createElement('a'); n.href = `#rzecz-${i.id}`; n.textContent = i.name;
        top.append(n);
        const pr = priceOf(i.id);
        if (pr != null) { const p = document.createElement('span'); p.className = 'hp'; p.textContent = zl(pr); top.append(p); }
        const w = document.createElement('span'); w.className = 'hw';
        w.textContent = i.outside ? `Na zewnątrz: ${i.outside}. ${i.why}` : i.why;
        li.append(top, w);
        return li;
      }));
      const link = $<HTMLAnchorElement>('.hc-more', card);
      link.href = c.pouch ? `#saszetka-${picked}` : `#kat-${picked}`;
      link.textContent = more ? `Jeszcze ${nR(more)}: zobacz całą listę` : 'Zobacz na liście';
    };

    const setOpenUi = (on: boolean) => {
      openBtn.setAttribute('aria-pressed', String(on));
      $('[data-open-l]', openBtn).textContent = on ? 'Zamknij plecak' : 'Otwórz plecak';
      stage.classList.toggle('is-open', on);
    };

    /** Wybór saszetki: otwiera plecak i unosi saszetkę; karta przy punkcie i wyróżnienie na liście */
    const pick = (id: string | null, focus = false) => {
      picked = id;
      groups.forEach((g) => g.classList.toggle('sel', g.dataset.cat === id));
      hotspots.forEach((h) => h.classList.toggle('sel', h.dataset.cat === id));
      $$('[data-show]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.show === id)));
      card.hidden = !id;
      if (id) fillCard();
      if (!bag) return;
      const c = id ? catById.get(id) : null;
      if (c?.pouch) { bag.open(true); setOpenUi(true); }
      bag.select(id);
      if (id && !c?.pouch && focus) { if (bag.isOpen()) { bag.open(false); setOpenUi(false); } bag.focus(id); }
    };

    /* ── Rysowanie listy, liczników, podsumowań ── */
    let first = true;
    const render = () => {
      const animate = !first;
      first = false;
      const kit = kitItems();
      const kitSet = new Set(kit.map((i) => i.id));
      const custom = isCustom();
      const label = verLabel();
      const verPressed: BagVersionId = custom ? 'custom' : base;
      verBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ver === verPressed)));
      verDesc.textContent = custom ? `${verById.get('custom')!.desc}` : verById.get(base)!.desc;
      cats.dataset.mode = custom ? 'custom' : base;
      bar.hidden = !custom;
      $('[data-cb-label]', bar).textContent = `Własny zestaw na bazie wersji ${levelLoc[base]}`;
      $('[data-reset]', bar).textContent = `Przywróć wersję ${verById.get(base)!.name}`;

      // Rzeczy: w plecaku albo w grupie „Możesz dodać” swojej saszetki
      const perCat = new Map<string, number>(), inside = new Map<string, string[]>();
      rows.forEach((li) => {
        const id = li.dataset.id!, it = byId.get(id)!;
        const on = kitSet.has(id);
        const g = groups.find((x) => x.dataset.cat === it.cat)!;
        const target = on ? $('[data-in]', g) : $('[data-out]', g);
        if (li.parentElement !== target) {
          target.append(li);
          if (animate && !reduce) { li.classList.remove('enter'); void li.offsetWidth; li.classList.add('enter'); }
        }
        li.classList.toggle('on', on);
        li.querySelector('input')!.checked = on;
        const note = $('[data-lvl]', li);
        if (on) note.textContent = add.has(id) && !inBase(id) ? `Dodane przez Ciebie, w standardzie w wersji ${levelLoc[it.level]}` : '';
        else note.textContent = inBase(id) ? `W standardzie w tej wersji, usunięte przez Ciebie` : `W standardzie w wersji ${levelLoc[it.level]}`;
        note.hidden = !note.textContent;
        if (on) {
          perCat.set(it.cat, (perCat.get(it.cat) || 0) + 1);
          if (!it.outside && catById.get(it.cat)!.pouch) inside.set(it.cat, [...(inside.get(it.cat) || []), it.name]);
        }
      });
      // kolejność jak w danych
      groups.forEach((g) => {
        for (const ul of [$('[data-in]', g), $('[data-out]', g)]) {
          const lis = [...ul.children] as HTMLElement[];
          const sorted = [...lis].sort((a, b) => rows.indexOf(a as HTMLLIElement) - rows.indexOf(b as HTMLLIElement));
          if (sorted.some((x, i) => x !== lis[i])) ul.append(...sorted);
        }
        const n = perCat.get(g.dataset.cat!) || 0;
        const out = $('[data-out]', g).children.length;
        tween($('[data-cc]', g), n, String, animate);
        $('[data-empty]', g).hidden = n > 0;
        const det = $<HTMLDetailsElement>('[data-add]', g);
        det.hidden = out === 0;
        $('[data-add-l]', det).textContent = `Możesz dodać (${out})`;
      });

      // Podsumowanie saszetek na górze listy
      const nP = inside.size;
      const nIn = [...inside.values()].reduce((s, a) => s + a.length, 0);
      $('[data-ps-n]').textContent = `${nS(nP)} w plecaku`;
      $('[data-ps-sub]').textContent = `, w nich ${nR(nIn)}`;
      $$('.ps-list li').forEach((li) => {
        const list = inside.get(li.dataset.cat!) || [];
        li.hidden = !list.length;
        $('[data-ps-k]', li).textContent = nR(list.length);
        $('[data-ps-i]', li).textContent = list.join(', ');
        li.title = list.join(', ');
      });
      const outs = kit.filter((i) => i.outside);
      const psOut = $('[data-ps-out]');
      psOut.hidden = !outs.length;
      psOut.textContent = outs.length ? `Na zewnątrz plecaka: ${outs.map((i) => `${i.name} (${i.outside})`).join(', ')}.` : '';

      hotspots.forEach((h) => tween(h.querySelector('b')!, perCat.get(h.dataset.cat!) || 0, String, animate));
      fallbackRows.forEach((r) => { const n = perCat.get(r.dataset.cat!) || 0; r.hidden = n === 0; r.querySelector('b')!.textContent = String(n); });
      vname.textContent = label;
      tween(total, kit.length, nR, animate);
      customCount.textContent = custom ? nR(kit.length) : 'do wyboru';

      // Suma przykładowych cen
      let sum = 0, miss = 0;
      kit.forEach((i) => { const p = priceOf(i.id); p == null ? miss++ : (sum += p); });
      tween($('[data-t-items]'), kit.length, String, animate);
      $('[data-t-items-l]').textContent = rzeczy(kit.length);
      tween($('[data-t-pouches]'), nP, String, animate);
      $('[data-t-pouches-l]').textContent = saszetek(nP);
      tween($('[data-t-sum]'), Math.round(sum), zlR, animate);
      $('[data-t-miss]').textContent = miss ? ` + ${nR(miss)} z ceną wkrótce` : '';
      $('[data-sb-v]', sbar).textContent = label;
      $('[data-t-v]').textContent = label;
      $('[data-sb-c]', sbar).textContent = `${nR(kit.length)} · ok. ${zlR(sum)}${miss ? '+' : ''}`;

      // Podsumowanie w formularzu, aktualizowane na żywo
      sel.value = custom ? 'custom' : base;
      const colName = colorById.get(color)?.name || '';
      $('.sel-sum', selBox).textContent = kit.length ? `${label}: ${nR(kit.length)}, ${nS(nP)} · kolor: ${colName}` : 'Twoja lista jest pusta. Dodaj rzeczy wyżej, w sekcji „W plecaku”.';
      $('.sel-items', selBox).replaceChildren(...kit.map((i) => {
        const li = document.createElement('li');
        const n = document.createElement('span'); n.textContent = i.name;
        const p = document.createElement('span'); const pr = priceOf(i.id); p.textContent = pr == null ? 'cena wkrótce' : zl(pr);
        if (pr == null) p.className = 'na';
        li.append(n, p);
        return li;
      }));
      $('.sel-total', selBox).textContent = kit.length ? `Szacunkowo: ${zlR(sum)}${miss ? ` + ${nR(miss)} z ceną wkrótce` : ''}` : '';
      if (animate && !reduce) { selBox.classList.remove('flash'); void selBox.offsetWidth; selBox.classList.add('flash'); }

      const active = new Set<string>(['plecak']);
      inside.forEach((_v, k) => active.add(k));
      bag?.setActive(active);
      bag?.setExtras({
        roll: kitSet.has('spiwor') || kitSet.has('tarp'), solar: kitSet.has('solar'), headlamp: kitSet.has('czolowka'),
        bottles: kitSet.has('woda'), batteries: kitSet.has('akumulatory'), tourniquet: kitSet.has('apteczka-pro'),
      });
      if (picked) { if (active.has(picked) || perCat.get(picked)) fillCard(); else pick(null); }
    };

    const save = () => {
      try { localStorage.setItem(KEY, JSON.stringify({ base, add: [...add], rem: [...rem], custom: customFlag })); } catch {}
      try {
        const u = new URL(location.href);
        for (const k of ['wersja', 'baza', 'dodaj', 'usun']) u.searchParams.delete(k);
        if (isCustom()) {
          u.searchParams.set('wersja', 'wlasny'); u.searchParams.set('baza', verById.get(base)!.slug);
          if (add.size) u.searchParams.set('dodaj', [...add].join(','));
          if (rem.size) u.searchParams.set('usun', [...rem].join(','));
        } else if (base !== 'basic') u.searchParams.set('wersja', verById.get(base)!.slug);
        color === bagModel.defaultColor ? u.searchParams.delete('kolor') : u.searchParams.set('kolor', color);
        history.replaceState(null, '', u.toString().replace(/%2C/g, ','));
      } catch {}
    };
    const setVersion = (v: BagVersionId) => {
      if (v === 'custom') customFlag = true;
      else { base = v; add.clear(); rem.clear(); customFlag = false; }
      render(); save();
    };
    const toggleItem = (id: string, on: boolean) => {
      if (on) { inBase(id) ? rem.delete(id) : add.add(id); }
      else { inBase(id) ? rem.add(id) : add.delete(id); }
      render(); save();
    };

    verBtns.forEach((b) => b.addEventListener('click', () => setVersion(b.dataset.ver as BagVersionId)));
    sel.addEventListener('change', () => setVersion(sel.value as BagVersionId));
    rows.forEach((li) => {
      li.querySelector('input')!.addEventListener('change', (e) => {
        const on = (e.target as HTMLInputElement).checked;
        toggleItem(li.dataset.id!, on);
        if (on) { li.classList.add('hl'); window.setTimeout(() => li.classList.remove('hl'), 1600); }
        // fokus zostaje na przełączniku, także gdy rzecz przeskoczy do listy „W plecaku” lub „Możesz dodać”
        li.querySelector('input')!.focus({ preventScroll: true });
      });
    });
    $('[data-reset]', bar).addEventListener('click', () => setVersion(base));
    $('[data-clear]', bar).addEventListener('click', () => {
      add.clear(); bagItems.forEach((i) => { if (inBase(i.id)) rem.add(i.id); }); customFlag = true;
      render(); save();
    });

    /* ── Kolor plecaka ── */
    const colName = $('[data-col-name]'), colNote = $('[data-col-note]');
    const plecakLi = rows.find((li) => li.dataset.id === 'plecak');
    const setColor = (id: string, persist = true) => {
      const c = colorById.get(id);
      if (!c) return;
      color = id;
      $$('[data-color]').forEach((b) => b.setAttribute(b.getAttribute('role') === 'radio' ? 'aria-checked' : 'aria-pressed', String(b.dataset.color === id)));
      colName.textContent = c.name;
      const parts = [c.cena ? `${zl(c.cena)} u producenta` : '', c.palette ? 'wzór uproszczony' : ''];
      parts.push(id === bagModel.defaultColor ? 'ten kolor mamy w plecaku testowym' : c.dostepny === false ? 'u producenta chwilowo niedostępny' : 'u producenta dostępny');
      colNote.textContent = parts.filter(Boolean).join(' · ');
      if (plecakLi) {
        const pn = plecakLi.querySelector<HTMLElement>('[data-pn]'), pp = plecakLi.querySelector<HTMLElement>('[data-pp]'), pu = plecakLi.querySelector<HTMLAnchorElement>('[data-pu]');
        if (pn) pn.textContent = `Wisport Whistler II 35, ${c.name}`;
        if (pp && c.cena) pp.textContent = zl(c.cena);
        if (pu && c.url) pu.href = c.url;
      }
      bag?.setColor({ id: c.id, hex: c.hex, palette: c.palette, pattern: c.pattern });
      if (persist) { render(); save(); }
    };
    $$<HTMLButtonElement>('[data-color]').forEach((b) => b.addEventListener('click', () => setColor(b.dataset.color!)));
    // Próbniki kamuflażu: prawdziwy wzór z tego samego generatora co na modelu (po załadowaniu modułu 3D)
    const paintSwatches = (camo: (p: string[], pat: 'pantera' | 'multi', size?: number) => HTMLCanvasElement) => {
      const cache = new Map<string, string>();
      $$('[data-color]').forEach((b) => {
        const c = colorById.get(b.dataset.color!);
        if (!c?.palette || !c.pattern) return;
        let url = cache.get(c.id);
        if (!url) { url = camo(c.palette, c.pattern, 96).toDataURL(); cache.set(c.id, url); }
        const el = b.querySelector<HTMLElement>('.sw-s') || b;
        el.style.background = `url(${url}) center/cover`;
      });
    };

    /* ── Model 3D i jego przyciski ── */
    hotspots.forEach((h) => h.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = h.dataset.cat!;
      pick(picked === id ? null : id, true);
    }));
    card.querySelector('.hc-x')!.addEventListener('click', () => pick(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && picked) pick(null); });
    openBtn.addEventListener('click', () => {
      if (!bag) return;
      const on = !bag.isOpen();
      if (!on) pick(null);
      bag.open(on); setOpenUi(on);
    });
    // Saszetka na liście lub chip partnera: plecak otwiera się i pokazuje saszetkę
    const inView = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return r.top >= 40 && r.bottom <= innerHeight; };
    $$<HTMLButtonElement>('[data-show]').forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.show!;
      if (!stage.classList.contains('gl-on')) {
        const c = catById.get(id)!;
        document.getElementById(c.pouch ? `saszetka-${id}` : `kat-${id}`)?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        return;
      }
      if (!inView(stage)) stage.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      pick(id, true);
    }));

    const canvas = stage.querySelector<HTMLCanvasElement>('canvas.gl')!;
    const hasGL = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    if (hasGL) {
      import('../lib/bag3d').then(({ mountBag, camoCanvas }) => {
        bag = mountBag({
          canvas, stage, hotspots, card,
          defs: bagCategories.map((c) => ({ id: c.id, anchor: c.anchor, normal: c.normal, pouch: c.pouch ? { hex: c.pouch.hex, cross: c.pouch.cross } : undefined })),
          modelUrl: root.dataset.model,
          reducedMotion: reduce,
          onPick: (id) => { if (id) pick(id === picked ? null : id); else if (picked) pick(null); },
        });
        (stage as any).bag = bag;
        stage.classList.add('gl-on');
        root.classList.add('has-gl');
        openBtn.hidden = false;
        paintSwatches(camoCanvas);
        setColor(color, false);
        render();
        if (picked) pick(picked);
      }).catch(() => stage.classList.remove('gl-on'));
    }

    /* ── Linki do rzeczy i saszetek: #rzecz-<id>, #saszetka-<id> ── */
    const fromHash = (smooth: boolean) => {
      const h = decodeURIComponent(location.hash.slice(1));
      let m = /^rzecz-(.+)$/.exec(h);
      if (m && byId.has(m[1])) {
        const li = document.getElementById(h)!;
        const det = li.closest('details');
        if (det) det.open = true;
        $$('.cats li.hl').forEach((x) => x !== li && x.classList.remove('hl'));
        li.classList.remove('hl'); void li.offsetWidth; li.classList.add('hl', 'target');
        li.scrollIntoView({ behavior: smooth && !reduce ? 'smooth' : 'auto', block: 'center' });
        pick(byId.get(m[1])!.cat);
        return;
      }
      m = /^saszetka-(.+)$/.exec(h);
      if (m && catById.get(m[1])?.pouch) {
        document.getElementById(h)?.scrollIntoView({ behavior: smooth && !reduce ? 'smooth' : 'auto', block: 'start' });
        pick(m[1]);
      }
    };
    addEventListener('hashchange', () => fromHash(true));

    // Przyklejony pasek na telefonie: widoczny, gdy przyciski z hero i formularz są poza ekranem
    const heroCta = root.querySelector('.cta-row')!;
    let sbQueued = false;
    const updateBar = () => {
      sbQueued = false;
      const c = heroCta.getBoundingClientRect(), f = form.getBoundingClientRect();
      sbar.classList.toggle('show', c.bottom < 0 && f.top > innerHeight);
    };
    addEventListener('scroll', () => { if (!sbQueued) { sbQueued = true; requestAnimationFrame(updateBar); } }, { passive: true });
    addEventListener('resize', updateBar);

    // Formularz: ten sam mechanizm co „Dla producentów” (/contact.php)
    (form.elements.namedItem('t') as HTMLInputElement).value = String(Date.now());
    const status = $('.status', form);
    const btn = $<HTMLButtonElement>('button[type=submit]', form);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const kit = kitItems();
      if (!kit.length) { status.textContent = 'Dodaj co najmniej jedną rzecz na liście albo wybierz gotową wersję.'; status.className = 'status err'; return; }
      const note = ($('#bg-note', form) as HTMLTextAreaElement).value.trim();
      const name = verLabel();
      const c = colorById.get(color)!;
      let sum = 0, miss = 0;
      const lines = kit.map((i) => {
        const p = priceOf(i.id);
        p == null ? miss++ : (sum += p);
        const prod = i.id === 'plecak' ? `Wisport Whistler II 35, ${c.name}` : i.produkt ? `${i.produkt.marka} ${i.produkt.nazwa}` : '';
        return `- ${i.name}${prod ? ` (${prod})` : ''}: ${p == null ? 'cena wkrótce' : zl(p)}`;
      });
      const set = (k: string, v: string) => ((form.elements.namedItem(k) as HTMLInputElement).value = v);
      set('company', `Plecak ewakuacyjny · ${name}`);
      set('category', `Plecak: ${name}`);
      set('message', [
        `Zgłoszenie ze strony plecaka ewakuacyjnego.`,
        `Wersja: ${name} (${nR(kit.length)})`,
        `Kolor plecaka: ${c.name}`,
        `Link do zestawu: ${location.href.split('#')[0]}`,
        '',
        ...lines,
        '',
        `Szacunkowo: ${zl(Math.round(sum))}${miss ? ` + ${nR(miss)} bez ceny` : ''}`,
        '',
        `Uwagi: ${note || 'brak'}`,
      ].join('\n').replace(/ /g, ' '));
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = form.dataset.sending!;
      status.className = 'status';
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const j = await r.json().catch(() => ({ ok: false }));
        if (!j.ok) throw new Error();
        $$('.row2, .f, .check, .sel-box, .actions button', form).forEach((el) => (el.hidden = true));
        status.textContent = form.dataset.ok!; status.classList.add('ok');
      } catch {
        status.textContent = form.dataset.err!; status.classList.add('err');
        btn.disabled = false; btn.textContent = label;
      }
    });

    setColor(color, false);
    render();
    updateBar();
    if (location.hash) requestAnimationFrame(() => fromHash(false));
  }
</script>

<style>
