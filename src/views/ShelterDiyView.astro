/* ---------- KALKULATOR ---------- */
/*CALC-START*/
const WALLS={
  sz25:{n:'pustak szalunkowy 25 cm',t:.25,units:8,fill:.14,steelM2:12,kind:'sz'},
  sz30:{n:'pustak szalunkowy 30 cm',t:.30,units:8,fill:.18,steelM2:14,kind:'sz'},
  mon25:{n:'żelbet monolityczny 25 cm',t:.25,kind:'mon'},
  bl24:{n:'bloczek betonowy, ściana 24 cm',t:.24,units:19.7,mortar:.035,kind:'bl'},
  bl38:{n:'bloczek betonowy, ściana 38 cm',t:.38,units:30.8,mortar:.07,kind:'bl'}
};
function calc(s){
  const w=WALLS[s.wall],tw=w.t,ts=s.strop/100,tp=s.plyta/100,ins=s.xps/100,cov=s.cover/100,ch=.10;
  const Lz=s.L+2*tw,Bz=s.B+2*tw,full=s.mode==='full';
  const depth=ch+tp+s.H+ts+(full?ins+cov:0);
  const bl=Lz+.3+2*s.work,bb=Bz+.3+2*s.work,tl=bl+2*s.n*depth,tb=bb+2*s.n*depth;
  const A1=bl*bb,A2=tl*tb,Am=((bl+tl)/2)*((bb+tb)/2);
  const Vex=depth/6*(A1+4*Am+A2);
  const Vstr=(Lz+.5)*(Bz+.5)*ch+(Lz+.3)*(Bz+.3)*tp+(Lz+2*ins)*(Bz+2*ins)*(s.H+ts+(full?ins:0));
  const backfill=Vex-Vstr;
  let mound=0;const hm=ins+cov;
  if(!full&&hm>0){const At=(Lz+1)*(Bz+1),Ab=(Lz+1+3*hm)*(Bz+1+3*hm);mound=hm/3*(At+Ab+Math.sqrt(At*Ab))-Lz*Bz*ins;}
  const surplus=Vex-backfill-mound;
  const cSlab=(Lz+.3)*(Bz+.3)*tp,cLean=(Lz+.5)*(Bz+.5)*ch,cRoof=Lz*Bz*ts;
  const wallA=Math.max(0,(2*(s.L+s.B)+4*tw)*s.H-1.8);
  let cWall=0,units=0,mortar=0,steelW=0,formwork=0;
  if(w.kind==='mon'){cWall=wallA*tw;steelW=cWall*90;formwork=2*wallA;}
  if(w.kind==='sz'){cWall=wallA*w.fill;units=wallA*w.units;steelW=wallA*w.steelM2;}
  if(w.kind==='bl'){units=wallA*w.units;mortar=wallA*w.mortar;}
  const cStruct=(cSlab+cRoof+cWall)*1.05;
  const steel=cSlab*80+cRoof*110+steelW;
  const hydro=2*(Lz+Bz)*(s.H+ts+tp)+Lz*Bz;
  const xpsA=ins>0?2*(Lz+Bz)*(s.H+ts)+Lz*Bz:0;
  const mat=2*(Lz+Bz)*(s.H+ts);
  const foil=(Lz+.5)*(Bz+.5);
  const drain=2*(Lz+Bz+2.4)+5;
  const q=cov*18+ts*25;
  const zb=s.H+ts+ins+cov;
  const press=.5*18*zb;
  const pf=Math.pow(2,ts*100/6+cov*100/9);
  const Q=s.persons*20;
  const dReq=Math.sqrt(4*(Q/3600/3)/Math.PI)*1000;
  const dStd=[110,125,160,200,250,315].find(v=>v>=dReq)||315;
  const vol=s.L*s.B*s.H;
  const area=s.area||s.L*s.B;
  return {w,tw,ts,tp,ins,cov,ch,Lz,Bz,full,depth,bl,bb,tl,tb,Vex,backfill,mound,surplus,loose:surplus*1.25,
    cSlab,cLean,cRoof,cWall,cStruct,wallA,units:Math.ceil(units*1.05),mortar:mortar*1.05,steel,formwork,
    hydro,xpsA,xpsV:xpsA*ins,mat,foil,drain,gravel:drain*.16,q,qkg:q*102,press,pf,Q,dStd,vol,area,
    perPerson:area/s.persons,co2h:vol/s.persons,water:s.persons*3*s.days,hm};
}
/*CALC-END*/
