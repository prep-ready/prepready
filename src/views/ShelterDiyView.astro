        <option value="bl24">Bloczek betonowy, ściana 24 cm</option>
        <option value="bl38">Bloczek betonowy, ściana 38 cm</option>
      </select></label>
      <label>Strop żelbetowy (cm)<input id="cS" type="number" inputmode="numeric" min="15" max="40" step="1" value="20"></label>
