  desc: 'Pięć projektów schronu do samodzielnej budowy: kontener 45 stóp, ziemianka z pustaków szalunkowych i trzy tańsze warianty. Rzuty, przekroje, izolacja i kalkulator materiałów.',
};
const jsonLd = { '@context': 'https://schema.org', '@type': 'TechArticle', headline: meta.title, description: meta.desc, inLanguage: 'pl', publisher: { '@type': 'Organization', name: 'PrepReady' } };
