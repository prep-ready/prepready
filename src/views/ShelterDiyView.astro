<script is:inline>

function D(o){
  const k=o.k,p=[],W=Math.round((o.x1-o.x0)*k),H=Math.round((o.y1-o.y0)*k);
  const X=x=>+((x-o.x0)*k).toFixed(1),Y=y=>+((y-o.y0)*k).toFixed(1),S=v=>+(v*k).toFixed(1);
  const a={
    rect(x,y,w,h,c){p.push(`<rect x="${X(x)}" y="${Y(y)}" width="${S(w)}" height="${S(h)}" class="${c}"/>`);return a},
    poly(pts,c){p.push(`<polygon points="${pts.map(q=>X(q[0])+','+Y(q[1])).join(' ')}" class="${c}"/>`);return a},
    line(x1,y1,x2,y2,c='ln'){p.push(`<line x1="${X(x1)}" y1="${Y(y1)}" x2="${X(x2)}" y2="${Y(y2)}" class="${c}"/>`);return a},
    circ(x,y,r,c='ln'){p.push(`<circle cx="${X(x)}" cy="${Y(y)}" r="${S(r)}" class="${c}"/>`);return a},
    text(x,y,s,c='tx',an='middle'){p.push(`<text x="${X(x)}" y="${Y(y)}" class="${c}" text-anchor="${an}">${s}</text>`);return a},
    mark(x,y,n){p.push(`<g class="mk"><circle cx="${X(x)}" cy="${Y(y)}" r="9.5"/><text x="${X(x)}" y="${Y(y)+3.7}" text-anchor="middle">${n}</text></g>`);return a},
    dimH(x1,x2,y,l){const t=l??Math.round((x2-x1)*100),a1=X(x1),a2=X(x2),b=Y(y);
      p.push(`<path class="dm" d="M${a1-6} ${b}H${a2+6}M${a1-4} ${b+4}L${a1+4} ${b-4}M${a2-4} ${b+4}L${a2+4} ${b-4}M${a1} ${b-7}V${b+7}M${a2} ${b-7}V${b+7}"/><text class="dt" text-anchor="middle" x="${(a1+a2)/2}" y="${b-6}">${t}</text>`);return a},
    dimV(y1,y2,x,l){const t=l??Math.round((y2-y1)*100),b1=Y(y1),b2=Y(y2),c=X(x),m=(b1+b2)/2;
      p.push(`<path class="dm" d="M${c} ${b1-6}V${b2+6}M${c-4} ${b1+4}L${c+4} ${b1-4}M${c-4} ${b2+4}L${c+4} ${b2-4}M${c-7} ${b1}H${c+7}M${c-7} ${b2}H${c+7}"/><text class="dt" text-anchor="middle" transform="rotate(-90 ${c-6} ${m})" x="${c-6}" y="${m}">${t}</text>`);return a},
    door(xp,yh,w,side){const r=S(w);p.push(`<path class="ln" d="M${X(xp)} ${Y(yh)}L${X(xp+side*w)} ${Y(yh)}"/><path class="lt" d="M${X(xp+side*w)} ${Y(yh)}A${r} ${r} 0 0 ${side>0?1:0} ${X(xp)} ${Y(yh+w)}"/>`);return a},
    bar(x,y){const b=Y(y);p.push(`<path class="ln" d="M${X(x)} ${b}H${X(x+2)}M${X(x)} ${b-5}V${b+5}M${X(x+1)} ${b-5}V${b+5}M${X(x+2)} ${b-5}V${b+5}"/><text class="tx" x="${X(x)}" y="${b+17}" text-anchor="middle">0</text><text class="tx" x="${X(x+1)}" y="${b+17}" text-anchor="middle">1</text><text class="tx" x="${X(x+2)}" y="${b+17}" text-anchor="middle">2 m</text>`);return a},
    out(){return `<svg viewBox="0 0 ${W} ${H}" width="${W}" style="min-width:${Math.min(W,760)}px;width:100%;max-width:${W}px" role="img" aria-label="${o.t}">${p.join('')}</svg>`}
  };return a;
}
const put=(id,d)=>{document.getElementById(id).innerHTML=d.out()};

/* RYS. 1 kontener rzut */
(function(){const d=D({k:62,x0:-.75,x1:14.45,y0:-1.35,y1:3.75,t:"Rzut kontenera 45 stóp z podziałem na strefy"});
  const Lc=13.716,Bc=2.438,i0=.14,i1=Bc-.14;
  d.rect(0,0,Lc,Bc,'f-steel').rect(.04,.04,Lc-.08,Bc-.08,'f-ins').rect(i0,i0,Lc-.28,Bc-.28,'bg');
  d.rect(0,.77,.14,.9,'bg').door(.14,.77,.9,1);
  d.rect(Lc-.14,.9,.14,.65,'bg').line(Lc-.14,.9,Lc,1.55,'lt').line(Lc-.14,1.55,Lc,.9,'lt');
  [[1.58,1.2],[3.58,1.2]].forEach(q=>{d.rect(q[0]-.03,i0,.06,i1-i0,'f-steel').rect(q[0]-.04,q[1],.08,.8,'bg').door(q[0],q[1],.8,1)});
  d.line(7.08,i0,7.08,i1,'ds');
  d.rect(11.05,i0,.06,i1-i0,'f-steel').rect(11.04,1.3,.08,.8,'bg').door(11.08,1.3,.8,-1);
  d.rect(1.68,.16,1.2,1,'fur').text(2.28,.7,'WODA').rect(2.93,.16,.6,.6,'fur').text(3.23,.5,'AKU');
  d.rect(2.6,1.93,.5,.35,'fur').circ(2.85,2.1,.06,'pipe');
  d.rect(3.68,.16,1.8,.6,'fur').text(4.58,.5,'BLAT').rect(5.38,1.58,1.2,.7,'fur').text(5.98,1.97,'STÓŁ').rect(5.6,.16,1.38,.4,'fur');
  d.rect(7.13,.16,1.95,.8,'fur').line(7.13,.16,9.08,.96,'lt').rect(9.12,.16,1.9,.8,'fur').line(9.12,.16,11.02,.96,'lt').rect(7.13,1.88,3.05,.4,'fur').text(8.65,2.12,'REGAŁ');
  d.rect(11.14,i0,1.14,1,'bgl').circ(11.4,.4,.06,'pipe').text(11.75,.92,'WC');
  d.rect(12.33,.16,1.22,.4,'fur').rect(11.2,1.88,2.36,.4,'fur');
  const xs=[.08,1.58,3.58,7.08,11.08,13.636],ls=[150,200,350,400,256];
  for(let i=0;i<5;i++)d.dimH(xs[i],xs[i+1],-.45,ls[i]);
  d.dimH(0,Lc,-.98,1372).dimV(0,Bc,-.4,244).dimV(i0,i1,14.05,'216 w świetle');
  d.mark(.6,2.05,1).mark(2.2,1.55,2).mark(4.9,1.25,3).mark(9,1.42,4).mark(11.95,.38,5).mark(12.95,1.22,6).mark(13.4,1.22,7).mark(3.32,2.1,8).mark(11.4,.75,9);
  d.bar(0,3.2).text(6.86,3.3,'WEJŚCIE GŁÓWNE Z LEWEJ, WYJŚCIE AWARYJNE Z PRAWEJ','tx');
  put('r1',d);})();

/* RYS. 2 kontener naziemny przekrój */
(function(){const d=D({k:112,x0:-1.5,x1:3.95,y0:-3.75,y1:1.45,t:"Przekrój poprzeczny kontenera naziemnego z ociepleniem od środka"});
  const B=2.438,top=-3.146,bot=-.25;
  d.rect(-1.5,0,5.45,1.45,'f-earth');
  d.rect(-.05,bot,.5,1.25,'f-conc').rect(B-.45,bot,.5,1.25,'f-conc');
