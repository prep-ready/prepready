let presetArea=0;
const $=id=>document.getElementById(id);
const nf=(v,d=1)=>v.toLocaleString('pl-PL',{minimumFractionDigits:d,maximumFractionDigits:d});
const num=(id,lo,hi,def)=>{let v=parseFloat(String($(id).value).replace(',','.'));if(!isFinite(v))v=def;return Math.min(hi,Math.max(lo,v))};
function read(){return{L:num('cL',1.5,20,5),B:num('cB',1.2,8,3),H:num('cH',1.8,3.5,2.2),wall:$('cW').value,strop:num('cS',15,40,20),plyta:num('cP',15,40,20),cover:num('cC',0,200,80),xps:num('cX',0,20,10),mode:$('cM').value,n:parseFloat($('cG').value),work:num('cR',.5,1.5,.8),persons:Math.round(num('cN',1,30,4)),days:Math.round(num('cD',1,60,7)),area:presetArea}}
function drawCalc(s,r){
  const yT=r.full?r.ins+r.cov:0,yRoofB=yT+r.ts,yFloor=yRoofB+s.H,ySlabB=yFloor+r.tp,yBot=ySlabB+r.ch;
  const tw=r.tw,B=s.B,xbl=-(tw+.15+s.work),xbr=B+tw+.15+s.work,xtl=xbl-s.n*r.depth,xtr=xbr+s.n*r.depth;
  const mh=r.full?0:r.hm,ml=-tw-.5-1.5*mh,mr=B+tw+.5+1.5*mh;
  const x0=Math.min(xtl,ml)-1.3,x1=Math.max(xtr,mr)+1.3,y0=-mh-1.9,y1=yBot+.95;
  const k=Math.max(28,Math.min(92,880/(x1-x0)));
  const d=D({k,x0,x1,y0,y1,t:'Przekrój poprzeczny dla wpisanych wymiarów'});
  d.rect(x0,0,x1-x0,y1,'f-earth').poly([[xtl,0],[xbl,yBot],[xbr,yBot],[xtr,0]],'f-fill');
  if(mh>0)d.poly([[ml,0],[-tw-.5,-mh],[B+tw+.5,-mh],[mr,0]],'f-fill');
  d.line(x0,0,x1,0,'gnd');
  d.rect(-tw-.25,ySlabB,B+2*tw+.5,r.ch,'f-conc').rect(-tw-.15,yFloor,B+2*tw+.3,r.tp,'f-rc');
  if(r.ins>0)d.rect(-tw-r.ins,yT-r.ins,B+2*tw+2*r.ins,r.ts+s.H+r.ins,'f-ins');
  const wc=r.w.kind==='mon'?'f-rc':'f-block';
  d.rect(-tw,yT,B+2*tw,r.ts,'f-rc').rect(-tw,yRoofB,tw,s.H,wc).rect(B,yRoofB,tw,s.H,wc).rect(0,yRoofB,B,s.H,'bg');
  d.circ(-tw-.5,yFloor,.08,'pipe').circ(B+tw+.5,yFloor,.08,'pipe');
  const pt=-mh-1;
  d.rect(B*.8,pt,.11,yFloor-.3-pt,'pipe').rect(B*.15,pt-.4,.11,yRoofB+.1-pt+.4,'pipe');
  d.dimH(0,B,yFloor-.35,Math.round(B*100)).dimV(yRoofB,yFloor,B*.5,Math.round(s.H*100));
  if(r.cov>0)d.dimV(yT-r.ins-r.cov,yT-r.ins,B*.5,Math.round(r.cov*100));
  d.dimV(0,yBot,xtl-.6,Math.round(r.depth*100)).dimH(xbl,xbr,yBot+.5,Math.round((xbr-xbl)*100)).dimH(xtl,xtr,-mh-1.45+(mh>0?0:.0),Math.round((xtr-xtl)*100));
  $('rc').innerHTML=d.out();
}
function render(){
  const s=read(),r=calc(s),F=[];
  if(r.area>35)F.push('Powierzchnia użytkowa przekracza 35 m². Taki obiekt wymaga pozwolenia na budowę, a nie zgłoszenia.');
  if(r.perPerson<1)F.push('Mniej niż 1 m² na osobę. Rozporządzenie wymaga co najmniej 1 m² powierzchni netto na każdego.');
  if(s.B>4.2)F.push('Rozpiętość stropu ponad 4,2 m. Strop '+s.strop+' cm może nie wystarczyć, rozważ ścianę lub podciąg w środku.');
  if(r.w.kind==='bl')F.push('Ściana z bloczków na zaprawie nie jest zbrojona. Pod ziemią wymaga wieńców i trzpieni żelbetowych albo zamiany na pustaki szalunkowe.');
  if(r.pf<100)F.push('Strop z przykryciem osłabia promieniowanie mniej niż 100 razy. Dla ochrony przed opadem promieniotwórczym dołóż ziemi.');
  if(r.depth>3)F.push('Wykop głębszy niż 3 m. Potrzebna koparka o dużym zasięgu i szczególna ostrożność przy skarpach; sprawdź poziom wód na tej głębokości.');
  if(r.surplus<0)F.push('Ziemi z wykopu zabraknie na zasypkę i nasyp. Trzeba dowieźć ok. '+nf(-r.surplus,0)+' m³.');
  $('flags').innerHTML=F.map(t=>`<p><b>UWAGA</b>${t}</p>`).join('');
  const G=[
    ['Wykop i ziemia',[['Głębokość wykopu',nf(r.depth,2)+' m'],['Dno wykopu',nf(r.bl,1)+' × '+nf(r.bb,1)+' m'],['Wykop na poziomie terenu',nf(r.tl,1)+' × '+nf(r.tb,1)+' m'],['Objętość wykopu',nf(r.Vex,0)+' m³'],['Zasypka wokół obiektu',nf(r.backfill,0)+' m³'],...(r.full?[]:[['Nasyp nad stropem',nf(r.mound,0)+' m³']]),[r.surplus>=0?'Nadmiar gruntu (w wykopie)':'Brak gruntu',nf(Math.abs(r.surplus),0)+' m³'],...(r.surplus>0?[['Do wywozu po spulchnieniu',nf(r.loose,0)+' m³']]:[])]],
    ['Beton i stal',[['Chudy beton C8/10',nf(r.cLean,1)+' m³'],['Płyta denna',nf(r.cSlab,1)+' m³'],['Strop',nf(r.cRoof,1)+' m³'],...(r.cWall>0?[[r.w.kind==='sz'?'Wypełnienie pustaków':'Ściany',nf(r.cWall,1)+' m³']]:[]),['Beton C20/25 razem (+5%)',nf(r.cStruct,1)+' m³'],['Stal zbrojeniowa (wskaźnik)',nf(Math.round(r.steel/10)*10,0)+' kg'],...(r.formwork>0?[['Szalunek ścian',nf(r.formwork,0)+' m²']]:[])]],
    ['Ściany',[['Wymiary zewnętrzne',nf(r.Lz,2)+' × '+nf(r.Bz,2)+' m'],['Powierzchnia ścian',nf(r.wallA,1)+' m²'],...(r.units>0?[[r.w.kind==='sz'?'Pustaki szalunkowe (+5%)':'Bloczki betonowe (+5%)',nf(r.units,0)+' szt.']]:[]),...(r.mortar>0?[['Zaprawa murarska',nf(r.mortar,1)+' m³']]:[])]],
    ['Izolacje i odwodnienie',[['Hydroizolacja',nf(r.hydro,0)+' m²'],['XPS '+s.xps+' cm',nf(r.xpsA,0)+' m² ('+nf(r.xpsV,1)+' m³)'],['Mata drenażowa',nf(r.mat,0)+' m²'],['Folia pod płytę',nf(r.foil,0)+' m²'],['Rura drenarska Ø100',nf(r.drain,0)+' m'],['Żwir do obsypki drenażu',nf(r.gravel,1)+' m³']]],
    ['Ludzie i powietrze',[['Powierzchnia użytkowa',nf(r.area,1)+' m²'],['Na osobę',nf(r.perPerson,1)+' m²'],['Kubatura',nf(r.vol,0)+' m³'],['Wymagany nawiew',nf(r.Q,0)+' m³/h'],['Przewód nawiewny i wywiewny','Ø'+r.dStd+' mm'],['Bez wentylacji 2% CO₂ po ok.',nf(r.co2h,0)+' h'],['Woda na '+s.days+' dni',nf(r.water,0)+' l']]],
    ['Obciążenia i osłona',[['Obciążenie stropu',nf(r.q,1)+' kN/m²'],['czyli ok.',nf(Math.round(r.qkg/10)*10,0)+' kg/m²'],['Parcie gruntu u podstawy ściany',nf(r.press,0)+' kPa'],['Osłabienie promieniowania (strop)',r.pf>=10000?'ponad 10 000×':'ok. '+nf(r.pf>=100?Math.round(r.pf/10)*10:Math.round(r.pf),0)+'×']]]
  ];
  $('res').innerHTML=G.map(g=>`<div><h4>${g[0]}</h4><dl>${g[1].map(x=>`<dt>${x[0]}</dt><dd>${x[1]}</dd>`).join('')}</dl></div>`).join('');
  drawCalc(s,r);
  render.text='Zestawienie: komora '+nf(s.L,2)+' × '+nf(s.B,2)+' × '+nf(s.H,2)+' m, '+r.w.n+', strop '+s.strop+' cm, ziemia '+s.cover+' cm\n\n'+G.map(g=>g[0].toUpperCase()+'\n'+g[1].map(x=>'  '+x[0]+': '+x[1]).join('\n')).join('\n\n')+'\n\nPrzedmiar orientacyjny z kalkulatora PrepReady. Konstrukcję zatwierdza projektant.';
}
function setPreset(key){const p=PRE[key];$('cL').value=p.L;$('cB').value=p.B;$('cH').value=p.H;$('cW').value=p.wall;$('cS').value=p.strop;$('cP').value=p.plyta;$('cC').value=p.cover;$('cM').value=p.mode;presetArea=p.area;
  document.querySelectorAll('[data-p]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.p===key));render();}
document.querySelectorAll('[data-p]').forEach(b=>b.addEventListener('click',()=>setPreset(b.dataset.p)));
$('f').addEventListener('input',e=>{if(['cL','cB'].includes(e.target.id)){presetArea=0;document.querySelectorAll('[data-p]').forEach(b=>b.setAttribute('aria-pressed','false'));}render();});
$('copy').addEventListener('click',()=>{const t=render.text,ok=()=>{$('copymsg').textContent='Skopiowano zestawienie do schowka.'},no=()=>{$('copybox').hidden=false;$('copyout').value=t;$('copyout').select();$('copymsg').textContent='Zaznaczono tekst poniżej. Skopiuj go skrótem klawiszowym.'};
  try{navigator.clipboard.writeText(t).then(ok,no)}catch(e){no()}});
render();
</script>

