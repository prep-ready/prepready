---
/** Strony sekcji: wiadomości, checklista, sprzęt. */
import Base from '../layouts/Base.astro';
import NewsFeed from '../components/NewsFeed.astro';
import Newsletter from '../components/Newsletter.astro';
import Checklist from '../components/Checklist.astro';
import GearTable from '../components/GearTable.astro';
import Deals from '../components/Deals.astro';
import feed from '../data/feed.json';
import { gearTest } from '../data/site';
import { routes, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; section: 'news' | 'checklist' | 'gear' }
const { lang, section } = Astro.props;
const M = {
  news: {
    pl: { title: 'Wiadomości kryzysowe — co to znaczy dla Ciebie', desc: 'Najważniejsze komunikaty z IMGW, RCB, PSE, CERT Polska i agencji prasowych, z krótką wskazówką, co zrobić.' },
    en: { title: 'Crisis news — what it means for you', desc: 'Key updates from official agencies and wire services, each with a short note on what to do.' },
  },
  checklist: {
    pl: { title: 'Plecak ewakuacyjny 72h — interaktywna checklista', desc: t('pl', 'cl.sub') },
    en: { title: '72-hour go-bag — interactive checklist', desc: t('en', 'cl.sub') },
  },
  gear: {
    pl: { title: 'Sprzęt na kryzys — testy i rankingi', desc: t('pl', 'gear.sub') },
    en: { title: 'Emergency gear — tests and rankings', desc: t('en', 'gear.sub') },
  },
}[section][lang];
const sample = section === 'news' ? feed[lang].sample : section === 'gear' ? gearTest.sample : false;
---
<Base lang={lang} title={M.title} description={M.desc} alternates={{ pl: routes[section].pl, en: routes[section].en }} current={section}>
  <div class="wrap page-head">
    <div class="head-row"><h1>{M.title}</h1>{sample && <span class="sample">{t(lang, 'sample')}</span>}</div>
    <p>{M.desc}</p>
  </div>
  <div class="wrap">
    {section === 'news' && <div class="two"><div><h2 class="sub">{lang === 'pl' ? 'Najnowsze' : 'Latest'}</h2><NewsFeed lang={lang} /></div><Newsletter lang={lang} /></div>}
    {section === 'checklist' && <Checklist lang={lang} />}
    {section === 'gear' && <div class="stack"><Deals lang={lang} showEmpty /><GearTable lang={lang} />
      <div class="prose method">{lang === 'pl' ? (
        <Fragment>
          <h2>Jak testujemy sprzęt</h2>
          <p>Każdy produkt w rankingu przechodzi te same pomiary, żeby wyniki dało się porównać. Nie przepisujemy danych z pudełka, bo deklarowana pojemność stacji zasilania i powerbanków zwykle różni się od tej, którą faktycznie da się wykorzystać.</p>
          <ul>
            <li>Pojemność: rozładowujemy w pełni naładowane urządzenie stałym obciążeniem około 100 W i mierzymy energię licznikiem.</li>
            <li>Ładowanie: mierzymy czas od 0 do 100% ze zwykłego gniazdka, bez dodatkowych akcesoriów.</li>
            <li>Ładowania telefonu: przeliczamy zmierzoną pojemność na typowy smartfon z baterią około 15 Wh, z uwzględnieniem strat.</li>
            <li>Ocena: łączy pomiary, cenę za watogodzinę, wagę i łatwość obsługi w stresie i po ciemku.</li>
          </ul>
          <p>Wartości w tabeli powyżej są przykładowe, dopóki nie opublikujemy pierwszego testu. Do rankingu trafia tylko sprzęt, który sprawdziliśmy.</p>
        </Fragment>
      ) : (
        <Fragment>
          <h2>How we test gear</h2>
          <p>Every product in a ranking goes through the same measurements so results can be compared. We do not copy numbers from the box: the advertised capacity of power stations and power banks usually differs from what you can actually use.</p>
          <ul>
            <li>Capacity: we fully discharge a charged unit at a steady load of about 100 W and measure the energy with a meter.</li>
            <li>Charging: we time 0 to 100% from an ordinary wall socket, with no extra accessories.</li>
            <li>Phone charges: we convert measured capacity into charges of a typical 15 Wh smartphone battery, allowing for losses.</li>
            <li>Score: combines the measurements, price per watt-hour, weight and how easy it is to use under stress and in the dark.</li>
          </ul>
          <p>Values in the table above are samples until we publish our first test. Only gear we have checked goes into a ranking.</p>
        </Fragment>
      )}</div></div>}
  </div>
</Base>
<style>
  .stack{display:grid;gap:24px}
  .method{margin-top:12px}
  .sub{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:12px}
  .head-row{display:flex;gap:16px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap}
  .two{display:grid;grid-template-columns:minmax(0,8fr) minmax(0,4fr);gap:24px;align-items:start}
  @media (max-width:980px){ .two{grid-template-columns:1fr} }
</style>
