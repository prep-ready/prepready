---
/**
 * Mapa schronów (tylko PL). Dane: „Punkty schronienia w Polsce”, KG PSP, dane.gov.pl, CC BY 4.0.
 * Pliki z punktami: /schrony/live/ (aktualizuje serwer co tydzień) albo /schrony/dane/ (dane startowe z workflow).
 * Wyszukiwanie adresu: Nominatim (OpenStreetMap). Mapa: Leaflet + kafelki OSM.
 */
import Base from '../layouts/Base.astro';
import { routes, guideBase } from '../i18n/ui';
import { community } from '../data/community';
import { readFileSync } from 'node:fs';
import { cities, type City } from '../data/cities';

// Dane startowe generuje workflow (scripts/shelters.mjs) przed budowaniem. Bez nich strona i tak działa —
// czyta dane w przeglądarce z /schrony/live/ albo /schrony/dane/.
let idx: { total: number; sourceDate: string | null } = { total: 0, sourceDate: null };
try { idx = JSON.parse(readFileSync('public/schrony/dane/index.json', 'utf8')); } catch {}

interface Props { city?: City }
const { city } = Astro.props;
const here = city ? `${routes.shelters.pl}${city.slug}/` : routes.shelters.pl;

const title = city
  ? `Schrony ${city.loc} — mapa, najbliższy schron`
  : 'Najbliższy schron — mapa schronów w Polsce';
const desc = city
  ? `Gdzie jest najbliższy schron ${city.loc}? Wpisz adres i zobacz na mapie schrony i miejsca ukrycia z bazy PSP: odległość, czas dojścia pieszo i dostępność 24h.`
  : 'Gdzie jest najbliższy schron? Wpisz adres i zobacz na mapie schrony i miejsca ukrycia z bazy Państwowej Straży Pożarnej: odległość, czas dojścia, dostępność 24h.';
const total = idx.total ? idx.total.toLocaleString('pl-PL') : 'ponad 80 tys.';
const faq: [string, string][] = [
  ...(city ? [
    [`Gdzie są schrony ${city.loc}?`, `Schrony i miejsca doraźnego schronienia ${city.loc} to głównie piwnice bloków i budynków publicznych, garaże podziemne, przejścia podziemne i masywne budynki wskazane przez Państwową Straż Pożarną. Wpisz swój adres na mapie powyżej, a pokażemy 10 najbliższych punktów z odległością i trasą pieszo.`],
    [`Jak sprawdzić, czy w moim bloku ${city.loc} jest schron?`, 'Wpisz adres bloku na mapie. Jeśli budynek jest w bazie PSP, pojawi się na liście jako punkt o odległości kilku metrów. Możesz też zapytać zarządcę budynku (spółdzielnię, wspólnotę) albo urząd miasta — wydział zarządzania kryzysowego.'],
  ] as [string, string][] : [
    ['Jak znaleźć najbliższy schron?', 'Wpisz adres albo użyj lokalizacji telefonu na mapie powyżej — pokażemy 10 najbliższych schronów i miejsc ukrycia z bazy PSP, z odległością, czasem dojścia i trasą pieszo. Te same dane ma oficjalna aplikacja gdziesieukryc.pl. W razie wątpliwości zapytaj zarządcę budynku albo urząd gminy.'],
    ['Czy w Polsce są schrony?', 'Tak. Państwowa Straż Pożarna zinwentaryzowała w całym kraju kilkadziesiąt tysięcy obiektów ochronnych: nieliczne schrony i ukrycia oraz znacznie więcej miejsc doraźnego schronienia — piwnic, garaży podziemnych, przejść podziemnych i stacji metra. Wszystkie są na tej mapie.'],
  ]),
  ['Co to jest punkt schronienia?', 'To sprawdzony przez Państwową Straż Pożarną obiekt, w którym można się ukryć przy zagrożeniu: piwnica, garaż podziemny, przejście podziemne, stacja metra albo masywny budynek. Nie każdy punkt to schron w ścisłym znaczeniu — chroni przede wszystkim przed odłamkami, gruzem i silnym wiatrem.'],
  ['Co znaczy dostępność „na żądanie”?', 'Obiekt nie jest stale otwarty. Udostępnia go zarządca albo samorząd, gdy ogłoszony zostanie alarm lub polecenie służb. Punkty „całodobowe” są dostępne o każdej porze, a „w określonych godzinach” — tylko w godzinach otwarcia obiektu.'],
  ['Skąd są dane i jak często się zmieniają?', 'Z bazy „Punkty schronienia w Polsce”, którą Komenda Główna PSP publikuje na dane.gov.pl na licencji CC BY 4.0. Aktualizujemy je automatycznie raz w tygodniu. Przed alarmem sprawdź swój punkt na miejscu — zarządca mógł go zmienić.'],
  ['Czym ta mapa różni się od gdziesieukryc.pl?', 'Korzysta z tych samych danych PSP. Oficjalna aplikacja gdziesieukryc.pl działa też offline i warto ją zainstalować na telefonie. Nasza mapa to szybkie sprawdzenie okolicy razem z poradnikami PrepReady.'],
];
const pageUrl = new URL(here, Astro.site).href;
const jsonLd: object[] = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: city ? `Mapa schronów — ${city.name}` : 'Mapa schronów PrepReady', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', inLanguage: 'pl', isAccessibleForFree: true, description: desc,
    ...(city ? { spatialCoverage: { '@type': 'City', name: city.name, containedInPlace: { '@type': 'AdministrativeArea', name: `województwo ${city.woj}` } } } : { spatialCoverage: { '@type': 'Country', name: 'Polska' } }) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
if (city) jsonLd.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'PrepReady', item: new URL(routes.home.pl, Astro.site).href },
  { '@type': 'ListItem', position: 2, name: 'Mapa schronów', item: new URL(routes.shelters.pl, Astro.site).href },
  { '@type': 'ListItem', position: 3, name: city.name, item: pageUrl },
] });
---
<Base lang="pl" title={title} description={desc} alternates={{ pl: here }} current="shelters" jsonLd={jsonLd}>
  <div class="wrap page-head">
    <div class="eyebrow">{city ? <><a href={routes.shelters.pl}>Mapa schronów</a> · {city.name}</> : 'Mapa schronów · Polska'}</div>
    <h1>{city ? `Schrony ${city.loc}: gdzie jest najbliższy schron?` : 'Gdzie jest najbliższy schron? Mapa schronów w Polsce'}</h1>
    <p>Wpisz adres albo użyj swojej lokalizacji. Pokażemy najbliższe schrony i miejsca ukrycia z bazy Państwowej Straży Pożarnej{city ? <> {city.loc} i okolicy</> : ''} — <span id="sh-total">{total}</span> zweryfikowanych miejsc w całym kraju.</p>
  </div>

  <div class="wrap">
    <form class="search panel" id="sh-form" role="search">
      <label class="sr-only" for="sh-q">Adres, ulica lub miejscowość</label>
      <input id="sh-q" name="q" type="search" autocomplete="street-address" placeholder={city ? `np. ul. Długa 5, ${city.name}` : "np. ul. Długa 5, Kraków"} required />
      <button class="btn primary" type="submit">Szukaj</button>
      <button class="btn ghost" type="button" id="sh-geo">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"/><path d="M8 0v3M8 13v3M0 8h3M13 8h3" stroke="currentColor" stroke-width="1.6"/><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        Moja lokalizacja
      </button>
    </form>
    <p class="status" id="sh-status" role="status" aria-live="polite"></p>
    <div class="alts" id="sh-alts" hidden></div>

    <div class="layout">
      <div class="mapbox panel">
        <div id="sh-map" aria-label={city ? `Mapa schronów ${city.loc}` : "Mapa punktów schronienia"} data-city={city ? JSON.stringify({ name: city.name, loc: city.loc, lat: city.lat, lng: city.lng }) : undefined}></div>
        <div class="legend">
          <span><i class="d a0"></i>Całodobowo</span>
          <span><i class="d a1"></i>W określonych godzinach</span>
          <span><i class="d a2"></i>Na żądanie</span>
        </div>
      </div>
      <aside class="list panel" aria-labelledby="sh-list-h">
        <div class="list-head">
          <h2 id="sh-list-h">Najbliższe punkty</h2>
          <div class="filter" role="group" aria-label="Filtr dostępności">
            <button type="button" class="chip" aria-pressed="false" id="sh-24h">Tylko całodobowe</button>
          </div>
        </div>
        <ol id="sh-list" class="results"></ol>
        <div class="empty" id="sh-empty">
          <p><strong>Zacznij od adresu.</strong> Mapa przybliży okolicę i ułoży punkty od najbliższego.</p>
          <p>Sprawdź też miejsca, w których bywasz najczęściej: pracę, szkołę dzieci, drogę dojazdu.</p>
        </div>
      </aside>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="eyebrow">Po usłyszeniu syreny</div>
      <h2>Co zrobić w pierwszych minutach</h2>
      <ol class="steps3">
        <li><span class="mono">01</span><div><strong>Rozpoznaj sygnał</strong><p>Modulowany dźwięk przez 3 minuty to ogłoszenie alarmu. Sprawdź komunikat w radiu, telewizji albo alercie RCB.</p><a class="link-more" href={`${guideBase.pl}syreny-alarmowe/`}>Posłuchaj syren →</a></div></li>
        <li><span class="mono">02</span><div><strong>Idź do najbliższego punktu</strong><p>Weź plecak 72h, dokumenty i leki. Jeśli punkt jest daleko, ukryj się w piwnicy lub w pomieszczeniu bez okien w środku budynku.</p><a class="link-more" href={`${guideBase.pl}schron-w-bloku/`}>Schron w bloku →</a></div></li>
        <li><span class="mono">03</span><div><strong>Zostań do odwołania</strong><p>Ciągły dźwięk przez 3 minuty oznacza odwołanie alarmu. Do tego czasu słuchaj komunikatów i poleceń służb.</p><a class="link-more" href={routes.checklist.pl}>Spakuj plecak 72h →</a></div></li>
      </ol>
    </div>
  </section>

  <section class="block">
    <div class="wrap"><div class="prose-lite">
      <div class="eyebrow">Jak to sprawdzić</div>
      <h2>{city ? `Jak znaleźć najbliższy schron ${city.loc}` : 'Jak znaleźć najbliższy schron — 3 sposoby'}</h2>
      <ol class="how">
        <li><strong>Mapa powyżej.</strong> Wpisz adres domu, pracy lub szkoły dzieci. Lista pokaże 10 najbliższych punktów, odległość, czas dojścia pieszo i to, czy obiekt jest otwarty całą dobę.</li>
        <li><strong>Aplikacja „Gdzie się ukryć”</strong> (<a href="https://gdziesieukryc.pl" target="_blank" rel="noopener">gdziesieukryc.pl</a>) — oficjalne narzędzie PSP na tych samych danych, działa też bez internetu. Zainstaluj ją na telefonie zawczasu.</li>
        <li><strong>Zarządca budynku i urząd {city ? 'miasta' : 'gminy'}.</strong> Spółdzielnia albo wspólnota wie, czy piwnica bloku jest wyznaczona jako miejsce schronienia. Wydział zarządzania kryzysowego {city ? 'urzędu miasta' : 'urzędu gminy'} ma listę obiektów i informacje o ich udostępnianiu.</li>
      </ol>
      <p>Schron, ukrycie i miejsce doraźnego schronienia to nie to samo. Prawdziwych schronów jest w Polsce niewiele, a większość punktów na mapie to piwnice, garaże podziemne i przejścia podziemne, które chronią przed odłamkami i gruzem. Jeśli punkt jest daleko, schowaj się w najniższej kondygnacji budynku, w pomieszczeniu bez okien — więcej w poradniku <a href={`${guideBase.pl}schron-w-bloku/`}>schron w bloku</a>. Żeby wiedzieć, kiedy iść, naucz się <a href={`${guideBase.pl}syreny-alarmowe/`}>rozpoznawać sygnały alarmowe</a>.</p>
    </div></div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="eyebrow">Miasta</div>
      <h2>Schrony w największych miastach Polski</h2>
      <ul class="cities">
        {cities.filter((c) => c.slug !== city?.slug).map((c) => <li><a href={`${routes.shelters.pl}${c.slug}/`}>Schrony {c.loc}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap two">
      <div>
        <div class="eyebrow">Pytania</div>
        <h2>{city ? `Schrony ${city.loc} — pytania` : 'Najczęstsze pytania o schrony'}</h2>
        <div class="faq">
          {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
      <div class="side">
        <div class="panel note-box">
          <div class="eyebrow">Ważne</div>
          <p><strong>Mapa jest pomocą, nie poleceniem służb.</strong> W sytuacji zagrożenia słuchaj komunikatów RCB, wojewody i straży pożarnej. Numer alarmowy: <span class="mono">112</span>.</p>
          <p>Oficjalna aplikacja PSP działa także offline: <a href="https://gdziesieukryc.pl" target="_blank" rel="noopener">gdziesieukryc.pl</a>.</p>
        </div>
        <div class="panel note-box">
          <div class="eyebrow">Źródło danych</div>
          <p>„Punkty schronienia w Polsce”, <a href="https://dane.gov.pl/pl/dataset/28058,punkty-schronienia-w-polsce" target="_blank" rel="noopener">Komenda Główna Państwowej Straży Pożarnej, dane.gov.pl</a>, licencja <a href="https://creativecommons.org/licenses/by/4.0/legalcode.pl" target="_blank" rel="noopener">CC BY 4.0</a>. Przetworzone przez PrepReady: podział na obszary i obliczanie odległości.</p>
          <p class="mono small" id="sh-src">Stan danych: {idx.sourceDate ?? '—'}</p>
          <p class="small">Wyszukiwanie adresów: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> (Nominatim).</p>
        </div>
        {community.tg.pl && <a class="btn ghost" href={community.tg.pl} target="_blank" rel="noopener">Błąd w danych? Napisz na Telegramie →</a>}
      </div>
    </div>
  </section>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type P = [number, number, number, string, string]; // latE5, lngE5, dostępność, adres, gmina
  type Index = { total: number; sourceDate: string | null; grid: { lat0: number; lng0: number; dLat: number; dLng: number }; cells: Record<string, number> };
  type Hit = { lat: number; lng: number; a: number; addr: string; gmina: string; d: number };

  const AVAIL = ['Całodobowo', 'W określonych godzinach', 'Na żądanie'];
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const statusEl = $('sh-status'), listEl = $('sh-list'), emptyEl = $('sh-empty'), altsEl = $('sh-alts');
  const only24 = $('sh-24h');
  const say = (msg: string, err = false) => { statusEl.textContent = msg; statusEl.classList.toggle('err', err); };

  // ── Dane: najpierw świeże z serwera (/schrony/live/), potem startowe z workflow (/schrony/dane/)
  let base = '/schrony/live/';
  let index: Index;
  async function loadIndex() {
    for (const b of ['/schrony/live/', '/schrony/dane/']) {
      try { const r = await fetch(b + 'index.json', { cache: 'no-cache' }); if (r.ok) { base = b; return (index = await r.json()); } } catch {}
    }
    throw new Error('Nie udało się wczytać danych.');
  }
  const cellCache = new Map<string, Promise<P[]>>();
  const cellOf = (lat: number, lng: number) => [Math.floor((lat - index.grid.lat0) / index.grid.dLat), Math.floor((lng - index.grid.lng0) / index.grid.dLng)];
  function cell(key: string): Promise<P[]> {
    if (!index.cells[key]) return Promise.resolve([]);
    if (!cellCache.has(key)) cellCache.set(key, fetch(`${base}c/${key}.json`).then((r) => r.json()).then((j) => j.p).catch(() => { cellCache.delete(key); return []; }));
    return cellCache.get(key)!;
  }
  async function around(lat: number, lng: number, ring: number) {
    const [r0, c0] = cellOf(lat, lng); const keys: string[] = [];
    for (let r = r0 - ring; r <= r0 + ring; r++) for (let c = c0 - ring; c <= c0 + ring; c++) keys.push(`${r}_${c}`);
    return (await Promise.all(keys.map(cell))).flat();
  }
  const R = 6371e3, rad = Math.PI / 180;
  const dist = (a: number, b: number, c: number, d: number) => {
    const x = Math.sin(((c - a) * rad) / 2) ** 2 + Math.cos(a * rad) * Math.cos(c * rad) * Math.sin(((d - b) * rad) / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(x));
  };

  // ── Mapa
  const cityAttr = document.getElementById('sh-map')?.dataset.city;
  const cityData: { name: string; loc: string; lat: number; lng: number } | null = cityAttr ? JSON.parse(cityAttr) : null;
  const map = L.map('sh-map', { zoomControl: true, attributionControl: true }).setView(cityData ? [cityData.lat, cityData.lng] : [52.07, 19.48], cityData ? 13 : 6);
  map.attributionControl.setPrefix('<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>');
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · punkty: <a href="https://dane.gov.pl/pl/dataset/28058">KG PSP</a>' }).addTo(map);
  const canvas = L.canvas({ padding: 0.3 });
  const dots = L.layerGroup().addTo(map);
  const top = L.layerGroup().addTo(map);
  let here: L.Marker | null = null;
  let origin: { lat: number; lng: number } | null = null;
  let hits: Hit[] = [];

  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const colors = () => [css('--l1'), css('--l3'), css('--muted')];
  const fmtD = (m: number) => (m < 10 ? 'do 10 m' : m < 1000 ? `${Math.round(m / 10) * 10} m` : `${(m / 1000).toFixed(1).replace('.', ',')} km`);
  const walk = (m: number) => { const min = Math.max(1, Math.round((m * 1.3) / 80)); return min > 90 ? 'ponad 1,5 h pieszo' : `ok. ${min} min pieszo`; };
  const route = (h: Hit) => `https://www.google.com/maps/dir/?api=1&destination=${h.lat},${h.lng}&travelmode=walking`;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const place = (h: Hit) => (h.gmina && h.gmina !== 'Nieznana' ? `${esc(h.gmina)} · ` : '');
  const popup = (h: Hit) => `<strong>${esc(h.addr)}</strong><br>${place(h)}${AVAIL[h.a]}${origin ? `<br>${fmtD(h.d)} · ${walk(h.d)}` : ''}<br><a href="${route(h)}" target="_blank" rel="noopener">Prowadź pieszo →</a>`;

  // Kropki wszystkich punktów w widoku (od przybliżenia 13)
  let drawn = new Set<string>();
  async function drawVisible() {
    if (!index || map.getZoom() < 13) { dots.clearLayers(); drawn = new Set(); return; }
    const b = map.getBounds(); const [r1, c1] = cellOf(b.getSouth(), b.getWest()); const [r2, c2] = cellOf(b.getNorth(), b.getEast());
    if ((r2 - r1 + 1) * (c2 - c1 + 1) > 16) return;
    const col = colors();
    for (let r = r1; r <= r2; r++) for (let c = c1; c <= c2; c++) {
      const key = `${r}_${c}`; if (drawn.has(key)) continue; drawn.add(key);
      for (const p of await cell(key)) {
        const h: Hit = { lat: p[0] / 1e5, lng: p[1] / 1e5, a: p[2], addr: p[3], gmina: p[4], d: origin ? dist(origin.lat, origin.lng, p[0] / 1e5, p[1] / 1e5) : 0 };
        L.circleMarker([h.lat, h.lng], { renderer: canvas, radius: 4, weight: 1, color: '#fff', fillColor: col[h.a], fillOpacity: 0.9 }).bindPopup(() => popup(h)).addTo(dots);
      }
    }
  }
  map.on('moveend', drawVisible);

  function render() {
    const list = (only24.getAttribute('aria-pressed') === 'true' ? hits.filter((h) => h.a === 0) : hits).slice(0, 10);
    top.clearLayers(); listEl.innerHTML = '';
    emptyEl.hidden = !!origin;
    if (!origin) return;
    if (!list.length) { listEl.innerHTML = '<li class="none">Brak punktów w promieniu kilkudziesięciu kilometrów dla wybranego filtra.</li>'; return; }
    const col = colors();
    list.forEach((h, i) => {
      const icon = L.divIcon({ className: 'sh-pin', html: `<span style="--c:${col[h.a]}">${i + 1}</span>`, iconSize: [26, 26], iconAnchor: [13, 13] });
      const m = L.marker([h.lat, h.lng], { icon, zIndexOffset: 1000 - i, title: h.addr }).bindPopup(popup(h)).addTo(top);
      const li = document.createElement('li');
      li.innerHTML = `<button type="button" class="hit"><span class="n mono" style="--c:${col[h.a]}">${i + 1}</span><span class="t"><strong>${esc(h.addr)}</strong><small>${place(h)}<span class="av a${h.a}">${AVAIL[h.a]}</span></small></span><span class="d mono">${fmtD(h.d)}<small>${walk(h.d)}</small></span></button><a class="go" href="${route(h)}" target="_blank" rel="noopener" aria-label="Prowadź pieszo do: ${esc(h.addr)}">Prowadź →</a>`;
      li.querySelector('button')!.addEventListener('click', () => { map.setView([h.lat, h.lng], Math.max(map.getZoom(), 16)); m.openPopup(); });
      listEl.append(li);
    });
    const b = L.latLngBounds(list.slice(0, 5).map((h) => [h.lat, h.lng] as [number, number])).extend([origin.lat, origin.lng]);
    map.fitBounds(b, { padding: [40, 40], maxZoom: 16 });
  }

  async function goTo(lat: number, lng: number, label: string) {
    origin = { lat, lng };
    if (here) here.remove();
    here = L.marker([lat, lng], { icon: L.divIcon({ className: 'sh-here', html: '<span></span>', iconSize: [18, 18], iconAnchor: [9, 9] }), zIndexOffset: 2000, title: 'Twoje miejsce' }).addTo(map);
    say('Szukam najbliższych punktów…');
    let pts: P[] = [];
    for (const ring of [1, 2, 4]) { pts = await around(lat, lng, ring); if (pts.length >= 10 && pts.some((p) => p[2] === 0)) break; }
    hits = pts.map((p) => ({ lat: p[0] / 1e5, lng: p[1] / 1e5, a: p[2], addr: p[3], gmina: p[4], d: dist(lat, lng, p[0] / 1e5, p[1] / 1e5) })).sort((x, y) => x.d - y.d);
    say(hits.length ? `${label} — najbliższy punkt: ${fmtD(hits[0].d)}.` : `${label} — w pobliżu nie ma punktów w bazie PSP.`);
    dots.clearLayers(); drawn = new Set();
    render();
    const u = new URL(location.href); u.searchParams.set('lat', lat.toFixed(5)); u.searchParams.set('lng', lng.toFixed(5)); history.replaceState(null, '', u);
  }

  // ── Wyszukiwanie adresu (Nominatim — tylko po wysłaniu formularza, bez podpowiedzi przy pisaniu)
  type Place = { lat: string; lon: string; display_name: string };
  const short = (s: string) => s.split(', ').filter((x) => !/^(województwo|Polska|\d{2}-\d{3})/.test(x)).slice(0, 4).join(', ');
  $('sh-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = ($('sh-q') as HTMLInputElement).value.trim(); if (!q) return;
    say('Szukam adresu…'); altsEl.hidden = true;
    try {
      // Nominatim nie rozumie skrótów „ul.”, „al.”, „pl.”, „os.” — usuwamy je (sama nazwa wystarcza).
      const norm = q.replace(/(^|[\s,])(ul|al|pl|os)\.\s*/gi, '$1').replace(/(^|[\s,])ulica\s+/gi, '$1').replace(/\s+/g, ' ').trim();
      const find = async (s: string): Promise<Place[]> => (await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&countrycodes=pl&limit=5&accept-language=pl&q=${encodeURIComponent(s)}`)).json();
      let res = await find(norm);
      // Bez wyniku: spróbuj bez numeru domu (sama ulica i miejscowość).
      const noNum = norm.replace(/\s\d+[a-zA-Z]?(\/\d+)?(?=\s*(,|$))/, '');
      if (!res.length && noNum !== norm) res = await find(noNum);
      if (!res.length) return say('Nie znaleziono tego adresu. Spróbuj dopisać miejscowość, np. „ul. Długa 5, Kraków”.', true);
      await goTo(+res[0].lat, +res[0].lon, short(res[0].display_name));
      if (res.length > 1) {
        altsEl.innerHTML = '<span>Chodziło o inne miejsce?</span>';
        res.slice(1).forEach((p) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = short(p.display_name); b.onclick = () => { altsEl.hidden = true; goTo(+p.lat, +p.lon, short(p.display_name)); }; altsEl.append(b); });
        altsEl.hidden = false;
      }
    } catch { say('Wyszukiwarka adresów nie odpowiada. Spróbuj za chwilę albo użyj swojej lokalizacji.', true); }
  });
  $('sh-geo').addEventListener('click', () => {
    if (!navigator.geolocation) return say('Ta przeglądarka nie udostępnia lokalizacji. Wpisz adres.', true);
    say('Pobieram lokalizację…');
    navigator.geolocation.getCurrentPosition(
      (p) => goTo(p.coords.latitude, p.coords.longitude, 'Twoja lokalizacja'),
      () => say('Nie mamy dostępu do lokalizacji. Wpisz adres albo zezwól na lokalizację w przeglądarce.', true),
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });
  only24.addEventListener('click', () => { only24.setAttribute('aria-pressed', String(only24.getAttribute('aria-pressed') !== 'true')); render(); });

  loadIndex().then(() => {
    $('sh-total').textContent = index.total.toLocaleString('pl-PL');
    if (index.sourceDate) $('sh-src').textContent = `Stan danych: ${index.sourceDate}`;
    const u = new URL(location.href); const lat = +u.searchParams.get('lat')!, lng = +u.searchParams.get('lng')!;
    if (lat && lng) goTo(lat, lng, 'Zapisane miejsce');
    else if (cityData) { drawVisible(); say(`Mapa pokazuje: ${cityData.name}. Wpisz dokładny adres, żeby ułożyć schrony od najbliższego.`); }
  }).catch((e) => say(e.message, true));
</script>

