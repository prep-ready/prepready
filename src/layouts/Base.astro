---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Adresy tej samej strony w obu językach — generują hreflang i przełącznik języka. */
  alternates?: Partial<Record<Lang, string>>;
  current?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { lang, title, description, alternates = {}, current, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const other: Lang = lang === 'pl' ? 'en' : 'pl';
// Dopisek marki tylko wtedy, gdy tytuł zmieści się w ~60 znakach (limit wyników Google).
const fullTitle = title.includes('PrepReady') || title.length + 12 > 60 ? title : `${title} · PrepReady`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Dane o serwisie na każdej stronie — pomagają Google i asystentom AI rozpoznać markę i język.
ld.unshift({
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'PrepReady', url: new URL(`/${lang}/`, site).href, inLanguage: lang,
  description: lang === 'pl' ? 'Poradniki na czas kryzysu, mapa schronów w Polsce, sygnały alarmowe i indeks gotowości.' : 'Crisis preparedness guides, checklists and a daily readiness index.',
  publisher: { '@type': 'Organization', name: 'PrepReady', url: site.href, logo: new URL('/favicon.svg', site).href, sameAs: ['https://t.me/prepreadyPL', 'https://t.me/prepready_global'] },
});
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="DEQNLS1FFWylPMmvLuL7WCaw5fb-DDakhQBT31PPQIs" />
    <meta name="convertiser-verification" content="265682ce0d5bd438856d819475eca0ee9071b0f1" />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {Object.entries(alternates).map(([l, href]) => (
    <link rel="alternate" hreflang={l} href={new URL(href!, site).href} />
  ))}
  {alternates.pl && <link rel="alternate" hreflang="x-default" href={new URL(alternates.pl, site).href} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="PrepReady" />
  <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
  <meta property="og:image" content={new URL(lang === 'pl' ? '/og-default.jpg' : '/og-default-en.jpg', site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={lang === 'pl' ? 'PrepReady: poradniki na czas kryzysu' : 'PrepReady: crisis preparedness guides'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#121619" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
  <link rel="alternate" type="application/rss+xml" title="PrepReady" href={`/${lang}/rss.xml`} />
  <script is:inline>
    try { var th = localStorage.getItem('pr-theme'); if (th === 'dark' || th === 'light') document.documentElement.dataset.theme = th; } catch (e) {}
  </script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <a class="skip" href="#main">{lang === 'pl' ? 'Przejdź do treści' : 'Skip to content'}</a>
  <Header lang={lang} altHref={alternates[other]} current={current} />
  <main id="main">
    <slot />
  </main>
<Analytics lang={lang} />
  <Footer lang={lang} />
</body>
</html>
