---
/** Proste ilustracje tematyczne (100×100) i ikony produktów (52×44). */
interface Props { name: string; size?: string }
const { name, size = '100%' } = Astro.props;
const big: Record<string, string> = {
  bolt: '<path d="M60 10 L34 58 H52 L44 90 L72 40 H54 Z" fill="var(--signal-bright)"/>',
  shelter: '<path d="M14 50 L50 18 L86 50" fill="none" stroke="var(--ink)" stroke-width="4"/><rect x="24" y="50" width="52" height="30" fill="none" stroke="var(--ink)" stroke-width="4"/><rect x="24" y="66" width="52" height="14" fill="var(--signal-bright)"/>',
  food: '<rect x="18" y="26" width="18" height="50" rx="3" fill="none" stroke="var(--ink)" stroke-width="4"/><rect x="42" y="36" width="18" height="40" rx="3" fill="var(--olive)"/><rect x="66" y="46" width="18" height="30" rx="3" fill="none" stroke="var(--ink)" stroke-width="4"/>',
  siren: '<path d="M30 70 V46 a20 20 0 0 1 40 0 V70 Z" fill="var(--signal-bright)"/><rect x="22" y="70" width="56" height="8" fill="var(--ink)"/><path d="M14 30 L24 36 M86 30 L76 36 M50 10 V20" stroke="var(--ink)" stroke-width="4"/>',
  bag: '<rect x="26" y="30" width="48" height="54" rx="8" fill="none" stroke="var(--ink)" stroke-width="4"/><path d="M38 30 V22 a12 12 0 0 1 24 0 V30" fill="none" stroke="var(--ink)" stroke-width="4"/><rect x="36" y="52" width="28" height="18" rx="3" fill="var(--signal-bright)"/>',
  cross: '<rect x="18" y="18" width="64" height="64" rx="10" fill="none" stroke="var(--ink)" stroke-width="4"/><path d="M43 30 H57 V43 H70 V57 H57 V70 H43 V57 H30 V43 H43 Z" fill="var(--signal-bright)"/>',
  drop: '<path d="M50 12 C36 34 28 46 28 58 a22 22 0 0 0 44 0 C72 46 64 34 50 12 Z" fill="none" stroke="var(--ink)" stroke-width="4"/><path d="M34 62 a16 16 0 0 0 32 0 Z" fill="var(--action)"/>',
};
const small: Record<string, string> = {
  filter: '<path d="M20 6h12l-2 10H22z M22 16h8v20a4 4 0 0 1-8 0z" fill="none" stroke="var(--ink-2)" stroke-width="2"/>',
  radio: '<rect x="10" y="16" width="32" height="22" rx="3" fill="none" stroke="var(--ink-2)" stroke-width="2"/><circle cx="20" cy="27" r="5" fill="none" stroke="var(--ink-2)" stroke-width="2"/><line x1="30" y1="23" x2="37" y2="23" stroke="var(--ink-2)" stroke-width="2"/><line x1="30" y1="29" x2="37" y2="29" stroke="var(--ink-2)" stroke-width="2"/><line x1="14" y1="16" x2="34" y2="8" stroke="var(--ink-2)" stroke-width="2"/>',
  lamp: '<path d="M10 26c0-8 32-8 32 0" fill="none" stroke="var(--ink-2)" stroke-width="2"/><rect x="21" y="20" width="10" height="8" rx="2" fill="var(--signal-bright)"/><line x1="26" y1="30" x2="26" y2="40" stroke="var(--ink-2)" stroke-width="2" stroke-dasharray="2 3"/>',
};
const isSmall = name in small;
---
<svg viewBox={isSmall ? '0 0 52 44' : '0 0 100 100'} width={size} height={size} aria-hidden="true" set:html={isSmall ? small[name] : big[name] ?? ''} />
