---
import { steps } from '../data/site';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<ol class="steps">
  {steps.map((s, i) => (
    <li class="step">
      <span class="n" aria-hidden="true">{i + 1}</span>
      <h3>{s.title[lang]}</h3>
      <p>{s.body[lang]}</p>
      <span class="meta">{s.meta[lang]}</span>
    </li>
  ))}
</ol>
<style>
  .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--surface)}
  .step{padding:22px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
  .step:last-child{border-right:0}
  .n{font-weight:900;font-size:44px;line-height:1;color:var(--signal-bright);font-stretch:70%}
  p{font-family:var(--body);font-weight:var(--body-w);color:var(--ink-2);font-size:15px}
  .meta{font-family:var(--mono);font-size:12px;color:var(--muted);margin-top:auto}
  @media (max-width:620px){ .steps{grid-template-columns:1fr} .step{border-right:0;border-bottom:1px solid var(--line)} .step:last-child{border-bottom:0} }
</style>
