---
/**
 * Google Analytics 4 (G-M7WL95P43G) z Google Consent Mode v2.
 * Domyślnie: brak zgody → GA wysyła tylko anonimowe sygnały bez cookies.
 * Po kliknięciu „Akceptuję” → pełne statystyki (cookies analityczne).
 * Reklamowe zgody zawsze odrzucone — nie używamy reklam Google.
 */
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const GA_ID = 'G-M7WL95P43G';
// Cloudflare Web Analytics — bez cookies, nie wymaga zgody; liczy wszystkie odsłony.
const CF_TOKEN = 'de609046a2584821983e9325a97634a8';
const T = lang === 'pl'
  ? { text: 'Używamy Google Analytics, żeby wiedzieć, które poradniki są czytane. Bez reklam i bez sprzedaży danych.', yes: 'Akceptuję', no: 'Nie, dziękuję' }
  : { text: 'We use Google Analytics to see which guides people read. No ads, no selling data.', yes: 'Accept', no: 'No thanks' };
---
<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  window.gtag = gtag;
  var c = null; try { c = localStorage.getItem('pr-consent'); } catch (e) {}
  gtag('consent', 'default', {
    analytics_storage: c === 'yes' ? 'granted' : 'denied',
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    wait_for_update: 500
  });
  gtag('js', new Date());
  gtag('config', GA_ID);
  var s = document.createElement('script');
  s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
  document.head.appendChild(s);
</script>
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_TOKEN })}></script>

<div id="pr-consent" class="pr-consent" role="region" aria-label="Cookies" hidden>
  <p>{T.text}</p>
  <div class="pr-consent-btns">
    <button type="button" class="btn ghost" data-consent="no">{T.no}</button>
    <button type="button" class="btn primary" data-consent="yes">{T.yes}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var box = document.getElementById('pr-consent');
    var c = null; try { c = localStorage.getItem('pr-consent'); } catch (e) {}
    if (c !== 'yes' && c !== 'no') box.hidden = false;
    box.addEventListener('click', function (e) {
      var v = e.target.getAttribute && e.target.getAttribute('data-consent');
      if (!v) return;
      try { localStorage.setItem('pr-consent', v); } catch (err) {}
      if (v === 'yes') {
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
        window.gtag('event', 'page_view'); // policz też stronę, na której kliknięto zgodę
      }
      box.hidden = true;
    });
  })();
</script>

<style>
  .pr-consent{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:center;justify-content:center;gap:12px 16px;flex-wrap:wrap;
    background:var(--surface);color:var(--ink-2);border-top:1px solid var(--line);padding:8px 16px;font-family:var(--body);font-size:13px}
  .pr-consent[hidden]{display:none}
  .pr-consent p{margin:0;max-width:70ch}
  .pr-consent-btns{display:flex;gap:6px}
  .pr-consent .btn{cursor:pointer;padding:5px 12px;font-size:13px;min-height:0}
</style>
