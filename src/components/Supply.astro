---
/**
 * Ceny i zaopatrzenie (tylko PL): paliwa (Weekly Oil Bulletin KE, co tydzień) i kursy walut NBP.
 * Dane zapisuje scripts/update-data.mjs w src/data/supply.json. Bez danych kafelek się nie pokazuje.
 */
import supply from '../data/supply.json';
const S = supply as any;
const h = S.fuel?.history ?? [];
const now = h.at(-1), prev = h.at(-2);
const fx = S.fx;
const zl = (v: number) => v.toFixed(2).replace('.', ',');
const pct = (a: number, b?: number) => (b ? ((a - b) / b) * 100 : null);
const fmtPct = (p: number | null) => (p === null ? '' : `${p >= 0 ? '+' : '−'}${Math.abs(p).toFixed(1).replace('.', ',')}%`);
const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('pl-PL', { day: 'numeric', month: 'long' });
const fuel = now ? [
  ['Pb95', now.pb95, prev?.pb95], ['ON', now.on, prev?.on], ['LPG', now.lpg, prev?.lpg],
] as [string, number, number | undefined][] : [];
const alert = fuel.some(([, v, p]) => (pct(v, p) ?? 0) > 5);
---
{(now || fx) && (
  <section class="supply panel" aria-labelledby="sup-h">
    <div class="head">
      <div class="eyebrow" id="sup-h">Ceny i zaopatrzenie</div>
      {alert && <span class="warn">paliwa +5% t/t</span>}
    </div>
    <ul>
      {fuel.map(([name, v, p]) => (
        <li><span class="k">{name}</span><span class="v">{zl(v)} zł/l</span><span class={(pct(v, p) ?? 0) > 0 ? 'd up' : 'd'}>{p !== undefined ? `${fmtPct(pct(v, p))} t/t` : ''}</span></li>
      ))}
      {fx && ['eur', 'usd'].map((c) => (
        <li><span class="k">{c.toUpperCase()}</span><span class="v">{zl(fx[c].value)} zł</span><span class="d">{fmtPct(pct(fx[c].value, fx[c].prev))} d/d</span></li>
      ))}
    </ul>
    <p class="src">
      {now && <>Paliwa: <a href="https://energy.ec.europa.eu/data-and-analysis/weekly-oil-bulletin_en" target="_blank" rel="noopener">biuletyn KE</a>, {day(now.date)}. </>}
      {fx && <>Kursy: <a href="https://nbp.pl/statystyka-i-sprawozdawczosc/kursy/" target="_blank" rel="noopener">NBP</a>.</>}
    </p>
  </section>
)}
<style>
  .supply{padding:16px 18px}
  .head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
  .warn{font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:2px 6px;border-radius:4px;background:var(--l4);color:var(--on-level)}
  ul{list-style:none;padding:0;margin:10px 0 0;display:grid;gap:6px}
  li{display:grid;grid-template-columns:44px 1fr auto;gap:8px;align-items:baseline;font-family:var(--mono);font-size:13px}
  .k{color:var(--muted)}
  .v{color:var(--ink);font-weight:600}
  .d{color:var(--muted);font-size:12px}
  .d.up{color:var(--l4)}
  .src{margin-top:10px;font-size:12px;color:var(--muted)}
  .src a{color:var(--action)}
</style>
