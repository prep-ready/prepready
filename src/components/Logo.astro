---
/** Znak PrepReady „Horyzont”: słońce nad linią horyzontu + wordmark. */
interface Props { size?: number; wordmark?: boolean }
const { size = 32, wordmark = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="12.4" fill="none" stroke="currentColor" stroke-width="3.2"/>
    <line x1="3.6" y1="19.6" x2="28.4" y2="19.6" stroke="currentColor" stroke-width="3.2"/>
    <circle cx="16" cy="12.6" r="3.2" fill="var(--signal-bright)"/>
  </svg>
  {wordmark && <b>PrepReady</b>}
</span>
<style>
  .logo{display:inline-flex;align-items:center;gap:9px;color:var(--ink)}
  b{font-size:22px;font-weight:720;font-stretch:80%;letter-spacing:-.005em;line-height:1}
</style>
