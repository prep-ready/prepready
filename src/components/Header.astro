---
import Logo from './Logo.astro';
import { routes, t, type Lang } from '../i18n/ui';
import readiness from '../data/readiness.json';
import { fmtDate } from '../i18n/ui';

interface Props { lang: Lang; altHref?: string; current?: string }
const { lang, altHref, current } = Astro.props;
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const nav = [
  ['index', 'nav.index'], ['news', 'nav.news'], ['guides', 'nav.guides'], ['checklist', 'nav.checklist'], ['gear', 'nav.gear'],
] as const;
const R = readiness[lang];
const updated = new Date(R.updatedAt);
const updatedLabel = `${fmtDate(updated, lang, { day: 'numeric', month: 'short', year: 'numeric' })}, ${updated.toLocaleTimeString(lang === 'pl' ? 'pl-PL' : 'en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Warsaw', timeZoneName: 'short' })}`;
---
<div class="strip" role="note">
  <div class="wrap">
    <span><span class="dot" aria-hidden="true"></span>{t(lang, 'strip.updated')}: {updatedLabel}</span>
    <span class="sep" aria-hidden="true">|</span>
    <span>{t(lang, 'strip.alerts')}</span>
    {R.sample && <span class="right">{t(lang, 'sample')}</span>}
  </div>
</div>
<header class="site">
  <div class="wrap">
    <a class="brand" href={routes.home[lang]} aria-label="PrepReady"><Logo /></a>
    <nav class="main" aria-label="Menu">
      {nav.map(([k, label]) => (
        <a href={routes[k][lang]} aria-current={current === k ? 'page' : undefined}>{t(lang, label)}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="lang" href={altHref ?? routes.home[other]} hreflang={other} lang={other}>{other.toUpperCase()}</a>
      <button class="theme" type="button" id="theme-toggle" aria-label={t(lang, 'theme')}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
      </button>
      <a class="btn primary cta" href={routes.checklist[lang]}>{t(lang, 'cta.start')}</a>
      <details class="mnav">
        <summary aria-label={t(lang, 'nav.menu')}>
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="2"/></svg>
        </summary>
        <div class="mnav-panel">
          {nav.map(([k, label]) => <a href={routes[k][lang]}>{t(lang, label)}</a>)}
          <a class="btn primary" href={routes.checklist[lang]}>{t(lang, 'cta.start')}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      var next = cur === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('pr-theme', next); } catch (e) {}
    });
  })();
</script>

<style>
  .strip{background:var(--ink);color:var(--bg);font-family:var(--mono);font-size:12px}
  .strip .wrap{display:flex;gap:14px;align-items:center;padding-block:8px;flex-wrap:wrap}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--l1);display:inline-block;margin-right:8px}
  .sep{opacity:.4}
  .right{margin-left:auto;color:var(--signal-bright)}
  header.site{background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
  header.site .wrap{display:flex;align-items:center;gap:28px;padding-block:12px}
  .brand{text-decoration:none}
  nav.main{display:flex;gap:22px;font-weight:600;font-size:14px}
  nav.main a{text-decoration:none;color:var(--ink-2);padding-block:4px;border-bottom:2px solid transparent}
  nav.main a:hover{color:var(--ink)}
  nav.main a[aria-current="page"]{color:var(--ink);border-color:var(--signal-bright)}
  .actions{margin-left:auto;display:flex;gap:8px;align-items:center}
  .lang,.theme,.mnav summary{border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:6px;height:34px;min-width:36px;display:grid;place-items:center;font-family:var(--mono);font-size:12px;text-decoration:none;padding-inline:8px}
  .mnav{display:none;position:relative}
  .mnav summary{list-style:none;cursor:pointer}
  .mnav summary::-webkit-details-marker{display:none}
  .mnav-panel{position:absolute;right:0;top:42px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px;display:grid;gap:4px;min-width:220px;box-shadow:0 12px 30px rgba(0,0,0,.18)}
  .mnav-panel a:not(.btn){padding:10px;text-decoration:none;font-weight:600;border-radius:6px}
  .mnav-panel a:not(.btn):hover{background:var(--surface-2)}
  .mnav-panel .btn{justify-content:center;margin-top:6px}
  @media (max-width:980px){ nav.main{display:none} .mnav{display:block} }
  @media (max-width:620px){ .cta{display:none} .strip .sep,.strip .right{display:none} header.site .wrap{gap:12px} }
</style>
