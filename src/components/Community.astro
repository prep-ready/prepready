---
import { community } from '../data/community';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const pl = lang === 'pl';
const gr = community.telegramGroup;
---
{gr && (
  <a class="tg" href={gr} rel="noopener" target="_blank">
    <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#229ED9"/><path d="M5.4 11.8l11.1-4.3c.5-.2 1 .1.8.9l-1.9 8.9c-.1.6-.5.8-1 .5l-2.8-2.1-1.4 1.3c-.2.2-.3.3-.6.3l.2-2.9 5.2-4.7c.2-.2 0-.3-.3-.1l-6.4 4-2.8-.9c-.6-.2-.6-.6.1-.9z" fill="#fff"/></svg>
    <span>
      <span class="t">{pl ? 'Grupa PrepReady na Telegramie' : 'PrepReady group on Telegram'}</span>
      <span class="d">{pl ? 'Pytania, sprzęt, wymiana doświadczeń. Dołącz do rozmowy.' : 'Questions, gear and shared experience. Join the conversation.'}</span>
    </span>
    <span class="go" aria-hidden="true">→</span>
  </a>
)}
<style>
  .tg{display:flex;gap:14px;align-items:center;padding:16px 18px;border:1px solid var(--line);background:var(--surface);border-radius:var(--radius);text-decoration:none}
  .tg:hover{border-color:#229ED9}
  .tg svg{flex:0 0 28px}
  .tg > span:nth-child(2){display:grid;gap:2px;flex:1}
  .t{font-weight:600;font-size:15px;color:var(--ink)}
  .d{font-family:var(--body);font-size:13.5px;color:var(--muted)}
  .go{color:var(--muted)}
</style>
