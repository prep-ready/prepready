---
import Icon from './Icon.astro';
import { guideTopics } from '../data/site';
import { clusters, clusterDesc, guideBase, t, fmtDate, type Lang } from '../i18n/ui';
import { articles, hrefOf } from '../lib/articles';

interface Props { lang: Lang }
const { lang } = Astro.props;
const list = await articles(lang);
const cards = guideTopics.map((g) => {
  const inCluster = list.filter((a) => a.data.cluster === g.cluster);
  const lead = inCluster.find((a) => a.data.kind === 'pillar') ?? inCluster[0];
  return { ...g, lead, count: inCluster.length };
});
---
<div class="guides">
  {cards.map((c) => {
    const Tag = c.lead ? 'a' : 'div';
    return (
      <Tag class:list={['guide', { soon: !c.lead }]} href={c.lead ? hrefOf(c.lead) : undefined}>
        <div class="art"><Icon name={c.icon} size="64%" /></div>
        <div class="body">
          <span class="eyebrow">{clusters[c.cluster][lang]}</span>
          <h3>{c.lead ? c.lead.data.title : clusters[c.cluster][lang]}</h3>
          <p>{c.lead ? c.lead.data.description : clusterDesc[c.cluster][lang]}</p>
          <div class="foot">
            {c.lead
              ? <span>{c.lead.data.readingMinutes} {t(lang, 'g.min')} · {t(lang, 'g.reviewed')} {fmtDate(c.lead.data.reviewed, lang, { month: '2-digit', year: 'numeric' })}</span>
              : <span>{t(lang, 'g.soon')}</span>}
            {c.lead && <span aria-hidden="true">→</span>}
          </div>
        </div>
      </Tag>
    );
  })}
</div>
<style>
  .guides{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .guide{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;text-decoration:none}
  .art{aspect-ratio:2/1;max-width:100%;background:var(--surface-2);display:grid;place-items:center;border-bottom:1px solid var(--line)}
  .body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:6px;flex:1}
  p{font-family:var(--body);font-weight:var(--body-w);color:var(--ink-2);font-size:14.5px}
  .foot{margin-top:auto;padding-top:8px;display:flex;justify-content:space-between;font-family:var(--mono);font-size:11.5px;color:var(--muted)}
  a.guide:hover h3{color:var(--action)}
  .soon .art{opacity:.55}
  .soon h3{color:var(--ink-2)}
  @media (max-width:980px){ .guides{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @media (max-width:560px){ .guides{grid-template-columns:1fr} .art{aspect-ratio:3/1} }
</style>
