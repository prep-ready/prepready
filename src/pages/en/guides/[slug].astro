---
import V from '../../../views/ArticleView.astro';
import { articles, slugOf } from '../../../lib/articles';
export async function getStaticPaths() {
  return (await articles('en')).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<V entry={entry} />
